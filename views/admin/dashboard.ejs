<%- include("../../views/partials/admin/header") %>

    <!-- Dashboard Content -->
    <div class="container-fluid p-4">
      <h2 class="mb-4">Dashboard Overview</h2>
      
      <!-- Stats Cards -->
      <div class="row g-4 mb-4">
        <div class="col-md-3">
          <div class="card text-white bg-primary">
            <div class="card-body">
              <h5 class="card-title">Total Sales</h5>
              <p class="card-text display-6">$12,450</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-white bg-success">
            <div class="card-body">
              <h5 class="card-title">Orders</h5>
              <p class="card-text display-6">245</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-white bg-info">
            <div class="card-body">
              <h5 class="card-title">Customers</h5>
              <p class="card-text display-6">180</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-white bg-warning">
            <div class="card-body">
              <h5 class="card-title">Products</h5>
              <p class="card-text display-6">89</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Activity -->
      <div class="row">
        <div class="col-md-8">
          <div class="card">
            <div class="card-header">
              <h5>Recent Orders</h5>
            </div>
            <div class="card-body">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>#1001</td>
                    <td>John Doe</td>
                    <td>$125.00</td>
                    <td><span class="badge bg-success">Delivered</span></td>
                  </tr>
                  <tr>
                    <td>#1002</td>
                    <td>Jane Smith</td>
                    <td>$89.50</td>
                    <td><span class="badge bg-warning">Pending</span></td>
                  </tr>
                  <tr>
                    <td>#1003</td>
                    <td>Mike Johnson</td>
                    <td>$210.00</td>
                    <td><span class="badge bg-info">Shipped</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        
        <div class="col-md-4">
          <div class="card">
            <div class="card-header">
              <h5>Quick Actions</h5>
            </div>
            <div class="card-body">
              <div class="d-grid gap-2">
                <a href="/admin/addProduct" class="btn btn-primary">Add New Product</a>
                <a href="/admin/orders" class="btn btn-success">View All Orders</a>
                <a href="/admin/users" class="btn btn-info">Manage Customers</a>
                <a href="/admin/sales" class="btn btn-warning">Sales Report</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
