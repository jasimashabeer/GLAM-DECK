<%- include("../../views/partials/admin/header") %>
<head>
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <!-- CropperJS for Add Product modal -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

  <style>
    /* ========== GLOBAL ADMIN LAYOUT STYLES ========== */
    body {
      background: #f5f6fa;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    .admin-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
    }

    /* ========== HEADER SECTION ========== */
    .page-header {
      background: white;
      border-radius: 20px;
      padding: 2rem 2.5rem;
      margin-bottom: 2rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .page-title {
      font-size: 2rem;
      font-weight: 700;
      color: #1a1a1a;
      margin: 0;
    }

    .btn-add-product {
      background: #4169E1;
      color: white;
      border: none;
      padding: 0.875rem 1.75rem;
      border-radius: 12px;
      font-size: 0.9375rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-add-product:hover {
      background: #3557c7;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(65, 105, 225, 0.3);
    }

    /* ========== FILTERS CARD ========== */
    .filters-card {
      background: white;
      border-radius: 20px;
      padding: 2rem 2.5rem;
      margin-bottom: 2rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .search-container {
      max-width: 600px;
      margin: 0 auto 1.5rem;
      position: relative;
    }

    .search-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      background: #f8f9fa;
      border-radius: 14px;
      padding: 0.5rem 1rem;
      transition: all 0.3s ease;
    }

    .search-wrapper:focus-within {
      background: white;
      box-shadow: 0 0 0 3px rgba(65, 105, 225, 0.1);
    }

    .search-icon {
      color: #6c757d;
      margin-right: 0.75rem;
    }

    .search-input {
      flex: 1;
      border: none;
      background: transparent;
      padding: 0.75rem 0;
      font-size: 0.9375rem;
      outline: none;
      color: #1a1a1a;
    }

    .search-input::placeholder {
      color: #adb5bd;
    }

    .btn-search {
      background: #4169E1;
      color: white;
      border: none;
      padding: 0.625rem 1.25rem;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      margin-left: 0.5rem;
      transition: all 0.2s ease;
    }

    .btn-search:hover {
      background: #3557c7;
    }

    .btn-clear {
      background: #e9ecef;
      color: #495057;
      border: none;
      padding: 0.625rem 1.25rem;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      margin-left: 0.5rem;
      transition: all 0.2s ease;
      text-decoration: none;
      display: inline-block;
    }

    .btn-clear:hover {
      background: #dee2e6;
      color: #495057;
    }

    .filter-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding: 0.75rem;
      background: #f8f9fa;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .filter-toggle:hover {
      background: #e9ecef;
    }

    .filter-toggle input[type="checkbox"] {
      width: 20px;
      height: 20px;
      cursor: pointer;
      accent-color: #4169E1;
    }

    .filter-toggle label {
      margin: 0;
      cursor: pointer;
      font-size: 0.9375rem;
      font-weight: 500;
      color: #495057;
    }

    /* ========== PRODUCTS TABLE CARD ========== */
    .table-card {
      background: white;
      border-radius: 20px;
      padding: 0;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      overflow: hidden;
    }

    .modern-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin: 0;
    }

    .modern-table thead {
      background: #f8f9fa;
    }

    .modern-table thead th {
      padding: 1.25rem 1.5rem;
      text-align: left;
      font-size: 0.8125rem;
      font-weight: 600;
      color: #6c757d;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 2px solid #e9ecef;
    }

    .modern-table tbody tr {
      transition: all 0.2s ease;
      border-bottom: 1px solid #f1f3f5;
    }

    .modern-table tbody tr:hover {
      background: #f8f9ff;
    }

    .modern-table tbody tr:last-child {
      border-bottom: none;
    }

    .modern-table tbody td {
      padding: 1.25rem 1.5rem;
      font-size: 0.9375rem;
      color: #495057;
      vertical-align: middle;
    }

    .product-name-cell {
      font-weight: 600;
      color: #1a1a1a;
      max-width: 200px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .price-cell {
      font-weight: 600;
      color: #1a1a1a;
      font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
    }

    /* ========== BADGES ========== */
    .badge-modern {
      padding: 0.4rem 0.85rem;
      border-radius: 8px;
      font-size: 0.8125rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
    }

    .badge-success {
      background: #d4edda;
      color: #155724;
    }

    .badge-warning {
      background: #fff3cd;
      color: #856404;
    }

    .badge-danger {
      background: #f8d7da;
      color: #721c24;
    }

    .badge-info {
      background: #d1ecf1;
      color: #0c5460;
    }

    .offer-badge {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 0.375rem 0.75rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 700;
    }

    /* ========== BUTTONS ========== */
    .btn-modern {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-size: 0.8125rem;
      font-weight: 500;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
      display: inline-block;
    }

    .btn-primary-modern {
      background: #4169E1;
      color: white;
    }

    .btn-primary-modern:hover {
      background: #3557c7;
      transform: translateY(-1px);
      box-shadow: 0 4px 8px rgba(65, 105, 225, 0.25);
      color: white;
    }

    .btn-success-modern {
      background: #28a745;
      color: white;
    }

    .btn-success-modern:hover {
      background: #218838;
      transform: translateY(-1px);
      box-shadow: 0 4px 8px rgba(40, 167, 69, 0.25);
      color: white;
    }

    .btn-danger-modern {
      background: #dc3545;
      color: white;
    }

    .btn-danger-modern:hover {
      background: #c82333;
      transform: translateY(-1px);
      box-shadow: 0 4px 8px rgba(220, 53, 69, 0.25);
      color: white;
    }

    .btn-info-modern {
      background: #17a2b8;
      color: white;
    }

    .btn-info-modern:hover {
      background: #138496;
      transform: translateY(-1px);
      box-shadow: 0 4px 8px rgba(23, 162, 184, 0.25);
      color: white;
    }

    .action-buttons {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    /* ========== PAGINATION ========== */
    .pagination-modern {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
      margin-top: 2rem;
      padding: 1.5rem;
    }

    .pagination-modern .page-item {
      list-style: none;
    }

    .pagination-modern .page-link {
      padding: 0.625rem 1rem;
      border-radius: 10px;
      border: 2px solid transparent;
      background: white;
      color: #495057;
      font-weight: 500;
      font-size: 0.9375rem;
      transition: all 0.2s ease;
      text-decoration: none;
      display: inline-block;
      min-width: 42px;
      text-align: center;
    }

    .pagination-modern .page-link:hover {
      background: #f8f9fa;
      border-color: #e9ecef;
      color: #1a1a1a;
    }

    .pagination-modern .page-item.active .page-link {
      background: #4169E1;
      color: white;
      border-color: #4169E1;
      box-shadow: 0 4px 8px rgba(65, 105, 225, 0.25);
    }

    /* ========== SCOPED STYLES FOR ADD PRODUCT MODAL ========== */
    .add-product-modal .error-message { 
      color: #dc3545; 
      font-size: 0.8125rem; 
      margin-top: 0.375rem; 
    }

    .add-product-modal .product-name-section {
      padding-bottom: 1rem;
    }

    .add-product-modal .product-name-wrapper {
      position: relative;
      max-width: 500px;
    }

    .add-product-modal .product-name-input {
      width: 100%;
      padding: 0.875rem 2.75rem 0.875rem 1rem;
      border: 2px solid #6b73ff;
      border-radius: 10px;
      font-size: 1rem;
      transition: border-color 0.2s;
      background: white;
    }

    .add-product-modal .product-name-input:focus {
      outline: none;
      border-color: #5b67f1;
    }

    .add-product-modal .dropdown-icon {
      position: absolute;
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: #86868b;
      pointer-events: none;
    }

    .add-product-modal .form-container {
      padding-bottom: 1rem;
    }

    .add-product-modal .form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .add-product-modal .form-card {
      background: white;
      border-radius: 16px;
      padding: 1.25rem 1.5rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .add-product-modal .card-title {
      font-size: 1.25rem;
      font-weight: 600;
      margin: 0 0 1rem 0;
      color: #1d1d1f;
    }

    .add-product-modal .form-group {
      margin-bottom: 1rem;
    }

    .add-product-modal .form-label {
      display: block;
      font-size: 0.875rem;
      font-weight: 500;
      color: #1d1d1f;
      margin-bottom: 0.5rem;
    }

    .add-product-modal .form-input,
    .add-product-modal .form-select,
    .add-product-modal .form-textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid #d2d2d7;
      border-radius: 8px;
      font-size: 0.9375rem;
      transition: border-color 0.2s;
      background: white;
      color: #1d1d1f;
    }

    .add-product-modal .form-input:focus,
    .add-product-modal .form-select:focus,
    .add-product-modal .form-textarea:focus {
      outline: none;
      border-color: #6b73ff;
    }

    .add-product-modal .form-textarea {
      resize: vertical;
      min-height: 120px;
      font-family: inherit;
    }

    .add-product-modal .pricing-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .add-product-modal .input-icon-wrapper {
      position: relative;
    }

    .add-product-modal .input-icon-wrapper input {
      padding-left: 2.25rem;
    }

    .add-product-modal .icon-dollar {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: #86868b;
      font-weight: 500;
      font-size: 0.9375rem;
    }

    .add-product-modal .icon-arrow {
      position: absolute;
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: #86868b;
      pointer-events: none;
    }

    .add-product-modal .upload-area {
      border: 2px dashed #d2d2d7;
      border-radius: 12px;
      padding: 2rem 1.5rem;
      text-align: center;
      background: #fafafa;
      cursor: pointer;
      transition: all 0.2s;
      margin-bottom: 1.25rem;
    }

    .add-product-modal .upload-area:hover {
      border-color: #6b73ff;
      background: #f5f5ff;
    }

    .add-product-modal .upload-icon {
      width: 56px;
      height: 56px;
      margin: 0 auto 1rem;
    }

    .add-product-modal .upload-icon svg {
      width: 100%;
      height: 100%;
      color: #6b73ff;
    }

    .add-product-modal .upload-text {
      font-size: 0.9375rem;
      color: #3c3c43;
      line-height: 1.5;
    }

    .add-product-modal .upload-text strong {
      font-weight: 500;
    }

    .add-product-modal #imagePreviewContainer {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }

    .add-product-modal .thumbnail-wrapper {
      position: relative;
      width: 110px;
      height: 110px;
    }

    .add-product-modal .thumbnail-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 10px;
      border: 1px solid #e5e5e7;
    }

    .add-product-modal .remove-image {
      position: absolute;
      top: -8px;
      right: -8px;
      background: #ff3b30;
      color: white;
      border-radius: 50%;
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 1.125rem;
      font-weight: 500;
      border: 3px solid white;
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }

    .add-product-modal .remove-image:hover {
      background: #d32f2f;
    }

    .add-product-modal .image-cropper {
      display: none;
      margin-top: 1.25rem;
      padding: 1.25rem;
      background: #fafafa;
      border-radius: 12px;
    }

    .add-product-modal .image-cropper img {
      max-width: 100%;
      display: block;
      border-radius: 8px;
    }

    .add-product-modal .btn-crop {
      background: #5b67f1;
      color: white;
      border: none;
      padding: 0.625rem 1.25rem;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      margin-top: 1rem;
    }

    .add-product-modal .btn-crop:hover {
      background: #4953d6;
    }

    .add-product-modal .tags-wrapper {
      position: relative;
    }

    .add-product-modal .tags-input {
      width: 100%;
      padding: 0.75rem 2.5rem 0.75rem 1rem;
      border: 1px solid #d2d2d7;
      border-radius: 8px;
      font-size: 0.9375rem;
      background: white;
    }

    .add-product-modal .tags-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: #86868b;
    }

    .add-product-modal .tags-container {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }

    .add-product-modal .tag {
      background: #f2f2f7;
      color: #3c3c43;
      padding: 0.4375rem 0.875rem;
      border-radius: 6px;
      font-size: 0.8125rem;
      font-weight: 500;
      border: 1px solid #e5e5e7;
    }

    /* ========== RESPONSIVE DESIGN ========== */
    @media (max-width: 1200px) {
      .add-product-modal .form-grid {
        grid-template-columns: 1fr;
      }
      
      .admin-container {
        padding: 1.5rem;
      }
    }

    @media (max-width: 992px) {
      .page-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
      }

      .modern-table {
        font-size: 0.875rem;
      }

      .modern-table thead th,
      .modern-table tbody td {
        padding: 1rem;
      }
    }

    @media (max-width: 768px) {
      .admin-container {
        padding: 1rem;
      }

      .page-header {
        padding: 1.5rem;
        border-radius: 16px;
      }

      .page-title {
        font-size: 1.5rem;
      }

      .filters-card {
        padding: 1.5rem;
      }

      .add-product-modal .pricing-row {
        grid-template-columns: 1fr;
      }

      .action-buttons {
        flex-direction: column;
      }

      .action-buttons .btn-modern {
        width: 100%;
      }

      .modern-table {
        display: block;
        overflow-x: auto;
        white-space: nowrap;
      }
    }
  </style>
</head>

<div class="admin-container">
  <!-- Page Header -->
  <div class="page-header">
    <h1 class="page-title">Products</h1>
    <button type="button" class="btn-add-product" data-bs-toggle="modal" data-bs-target="#addProductModal">
      <i class="bi bi-plus-lg"></i>
      <span>Add Product</span>
    </button>
  </div>

  <!-- Filters Card -->
  <div class="filters-card">
    <form action="/admin/products" method="GET">
      <div class="search-container">
        <div class="search-wrapper">
          <i class="bi bi-search search-icon"></i>
          <input 
            type="text" 
            class="search-input" 
            placeholder="Search products or brands..."
            name="search" 
            value="<%= search || '' %>"
          />
          <% if (low) { %>
            <input type="hidden" name="low" value="1">
          <% } %>
          <button class="btn-search" type="submit">Search</button>
          <% if (search) { %>
            <a href="/admin/products" class="btn-clear">Clear</a>
          <% } %>
        </div>
      </div>
    </form>

    <div class="filter-toggle">
      <input 
        class="form-check-input" 
        type="checkbox" 
        id="lowStock"
        onchange="toggleLowStock()" 
        <%= low ? 'checked' : '' %>
      />
      <label class="form-check-label" for="lowStock">
        Show only low stock (< 5 units)
      </label>
    </div>
  </div>

  <!-- Products Table -->
  <div class="table-card">
    <table class="modern-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Material</th>
          <th>Category</th>
          <th>Sale Price</th>
          <th>Offer</th>
          <th>Manage Offer</th>
          <th>Stock</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% data.slice().reverse().forEach(p => { %>
          <tr>
            <td class="product-name-cell"><%= p.productName %></td>
            <td><%= p.author %></td>
            <td><%= p.category.name %></td>
            <td class="price-cell">₹<%= p.salePrice %></td>
            
            <!-- Offer Badge -->
            <td>
              <% if (p.productOffer && p.productOffer > 0) { %>
                <span class="offer-badge"><%= p.productOffer %>% OFF</span>
              <% } else { %>
                <span class="badge-modern" style="background: #e9ecef; color: #6c757d;">No Offer</span>
              <% } %>
            </td>

            <!-- Add/Remove Offer -->
            <td>
              <% if (!p.productOffer) { %>
                <button class="btn-modern btn-info-modern" onclick="addOffer('<%= p._id %>')">
                  <i class="bi bi-tag"></i> Add Offer
                </button>
              <% } else { %>
                <button class="btn-modern btn-danger-modern" onclick="removeOffer('<%= p._id %>')">
                  <i class="bi bi-x-circle"></i> Remove
                </button>
              <% } %>
            </td>

            <!-- Stock Badge -->
            <td>
              <% if (p.quantity === 0) { %>
                <span class="badge-modern badge-danger">
                  <i class="bi bi-exclamation-circle-fill"></i> Out of Stock
                </span>
              <% } else if (p.quantity < 5) { %>
                <span class="badge-modern badge-warning">
                  <i class="bi bi-exclamation-triangle-fill"></i> <%= p.quantity %> left
                </span>
              <% } else { %>
                <span class="badge-modern badge-success">
                  <i class="bi bi-check-circle-fill"></i> <%= p.quantity %> in stock
                </span>
              <% } %>
            </td>

            <!-- Action Buttons -->
            <td>
              <div class="action-buttons">
                <% if (!p.isBlocked) { %>
                  <a href="/admin/blockProduct?id=<%= p._id %>" class="btn-modern btn-danger-modern">
                    <i class="bi bi-slash-circle"></i> Block
                  </a>
                <% } else { %>
                  <a href="/admin/unblockProduct?id=<%= p._id %>" class="btn-modern btn-success-modern">
                    <i class="bi bi-check-circle"></i> Unblock
                  </a>
                <% } %>
                <a href="/admin/editProduct?id=<%= p._id %>" class="btn-modern btn-primary-modern">
                  <i class="bi bi-pencil-square"></i> Edit
                </a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <nav aria-label="Page navigation">
    <ul class="pagination-modern">
      <% for(let i = 1; i <= totalPages; i++) { %>
        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
          <a 
            class="page-link" 
            href="?page=<%= i %><%= search ? `&search=${encodeURIComponent(search)}` : '' %><%= low ? '&low=1' : '' %>"
          >
            <%= i %>
          </a>
        </li>
      <% } %>
    </ul>
  </nav>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<!-- Bootstrap JS bundle (required for modal to work) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
/* ————— Low‑stock toggle ————— */
function toggleLowStock() {
  const url = new URL(window.location.href);
  const lowOn = document.getElementById('lowStock').checked;
  if (lowOn) url.searchParams.set('low', '1');
  else url.searchParams.delete('low');
  window.location.href = url.toString();
}
</script>

<script>
/* ——— ADD product offer ——— */
async function addOffer(productId) {
  const { value: discount } = await Swal.fire({
    title: 'Add Product Offer',
    input: 'number',
    inputLabel: 'Discount (%)',
    inputPlaceholder: '0‑90',
    inputAttributes: { min: 1, max: 90 },
    showCancelButton: true,
    confirmButtonColor: '#4169E1',
    cancelButtonColor: '#6c757d',
  });

  if (!discount) return;

  try {
    const res = await fetch('/admin/addProductOffer', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId, discount })
    });
    const data = await res.json();

    if (res.ok && data.status) {
      Swal.fire({
        icon: 'success',
        title: 'Success!',
        text: 'Offer applied to product.',
        confirmButtonColor: '#4169E1'
      }).then(() => location.reload());
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Failed',
        text: data.message || 'Could not add offer',
        confirmButtonColor: '#4169E1'
      });
    }
  } catch (err) {
    Swal.fire({
      icon: 'error',
      title: 'Error',
      text: 'Server error while adding offer',
      confirmButtonColor: '#4169E1'
    });
  }
}

/* ——— REMOVE product offer ——— */
async function removeOffer(productId) {
  const result = await Swal.fire({
    title: 'Remove offer?',
    text: 'This will remove the discount from this product.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#dc3545',
    cancelButtonColor: '#6c757d',
    confirmButtonText: 'Yes, remove it'
  });

  if (!result.isConfirmed) return;

  try {
    const res = await fetch('/admin/removeProductOffer', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId })
    });
    const data = await res.json();

    if (res.ok && data.status) {
      Swal.fire({
        icon: 'success',
        title: 'Removed!',
        text: 'Offer removed from product.',
        confirmButtonColor: '#4169E1'
      }).then(() => location.reload());
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Failed',
        text: data.message || 'Could not remove offer',
        confirmButtonColor: '#4169E1'
      });
    }
  } catch (err) {
    Swal.fire({
      icon: 'error',
      title: 'Error',
      text: 'Server error while removing offer',
      confirmButtonColor: '#4169E1'
    });
  }
}
</script>

