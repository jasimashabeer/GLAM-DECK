<!-- Reuse Add Product client‑side logic inside modal -->
<script>
let cropper;
let croppedBlobs = [];

// Sync product name
const mainInput = document.querySelector('.product-name-input');
const displayInput = document.querySelector('input[name="productName_display"]');

if (mainInput && displayInput) {
  mainInput.addEventListener('input', function() {
    displayInput.value = this.value;
  });
}

function handleImage(input) {
  if (!input.files.length) return;

  if (croppedBlobs.length >= 3) {
    Swal.fire({
      icon: 'warning',
      title: 'Limit Reached',
      text: 'You can upload exactly 3 images',
      confirmButtonColor: '#4169E1'
    });
    input.value = "";
    return;
  }

  const reader = new FileReader();
  reader.onload = () => {
    const image = document.getElementById("cropperPreview");
    if (!image) return;
    image.src = reader.result;

    const cropperContainer = document.querySelector(".image-cropper");
    if (cropperContainer) {
      cropperContainer.style.display = "block";
    }

    if (cropper) cropper.destroy();
    cropper = new Cropper(image, { aspectRatio: 1, viewMode: 1 });
  };
  reader.readAsDataURL(input.files[0]);
}

function saveCroppedImage() {
  if (!cropper) return;

  cropper.getCroppedCanvas().toBlob(blob => {
    croppedBlobs.push(blob);
    addPreview(blob);

    cropper.destroy();
    cropper = null;

    const oldImg = document.getElementById("cropperPreview");
    if (oldImg) {
      const newImg = oldImg.cloneNode();
      newImg.src = "";
      oldImg.parentNode.replaceChild(newImg, oldImg);
    }

    const cropperContainer = document.querySelector(".image-cropper");
    if (cropperContainer) {
      cropperContainer.style.display = "none";
    }
    const uploadInput = document.getElementById("uploadInput");
    if (uploadInput) {
      uploadInput.value = "";
    }
  }, "image/jpeg");
}

function addPreview(blob) {
  const container = document.getElementById("imagePreviewContainer");
  if (!container) return;

  const wrapper = document.createElement("div");
  wrapper.className = "thumbnail-wrapper";

  const img = document.createElement("img");
  img.src = URL.createObjectURL(blob);

  const removeBtn = document.createElement("div");
  removeBtn.className = "remove-image";
  removeBtn.innerHTML = "&times;";
  removeBtn.onclick = () => {
    const index = [...container.children].indexOf(wrapper);
    croppedBlobs.splice(index, 1);
    wrapper.remove();
  };

  wrapper.appendChild(img);
  wrapper.appendChild(removeBtn);
  container.appendChild(wrapper);
}

function validateForm() {
  let isValid = true;

  const productNameError = document.getElementById("productName-error");
  const productName = mainInput ? mainInput.value.trim() : "";

  if (!productName) {
    if (productNameError) productNameError.innerText = "Product name is required";
    isValid = false;
  } else if (productNameError) {
    productNameError.innerText = "";
  }

  const fields = ["material", "description", "regularPrice", "quantity", "category"];

  fields.forEach(field => {
    const fieldEl = document.getElementsByName(field)[0];
    const value = fieldEl ? fieldEl.value.trim() : "";
    const errorEl = document.getElementById(field + "-error");

    if (!value) {
      if (errorEl) errorEl.innerText = `${field} is required`;
      isValid = false;
    } else if (errorEl) {
      errorEl.innerText = "";
    }
  });

  const priceInput = document.getElementsByName("regularPrice")[0];
  const price = priceInput ? parseFloat(priceInput.value) : NaN;
  if (isNaN(price) || price <= 1) {
    const priceError = document.getElementById("regularPrice-error");
    if (priceError) priceError.innerText = "Regular price must be greater than ₹1";
    isValid = false;
  }

  if (croppedBlobs.length !== 3) {
    const imgError = document.getElementById("images-error");
    if (imgError) imgError.innerText = "Please upload exactly 3 images";
    isValid = false;
  } else {
    const imgError = document.getElementById("images-error");
    if (imgError) imgError.innerText = "";
  }

  return isValid;
}

const productForm = document.getElementById('productForm');
if (productForm) {
  productForm.addEventListener('submit', async function (e) {
    e.preventDefault();

    if (!validateForm()) return;

    if (cropper) {
      try {
        cropper.destroy();
      } catch (err) {
        console.error('Error destroying cropper:', err);
      }
      cropper = null;
    }

    const cropperContainer = document.querySelector(".image-cropper");
    if (cropperContainer) {
      cropperContainer.style.display = "none";
    }

    const previewImg = document.getElementById("cropperPreview");
    if (previewImg) {
      previewImg.src = "";
    }

    const form = e.target;
    const formData = new FormData();

    const productNameValue = mainInput ? mainInput.value.trim() : "";
    formData.append("productName", productNameValue);

    ["material", "description", "regularPrice", "quantity", "category"]
      .forEach(field => {
        if (form[field]) {
          formData.append(field, form[field].value);
        }
      });

    if (croppedBlobs.length !== 3) {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'Please upload exactly 3 images',
        confirmButtonColor: '#4169E1'
      });
      return;
    }

    croppedBlobs.forEach((blob, index) => {
      formData.append("images", blob, `product-${index + 1}.jpg`);
    });

    const response = await fetch('/admin/addProduct', {
      method: 'POST',
      body: formData
    });

    if (response.ok) {
      croppedBlobs = [];

      Swal.fire({
        icon: 'success',
        title: 'Success',
        text: 'Product added successfully!',
        confirmButtonColor: '#4169E1'
      }).then(() => window.location.reload());
    } else {
      const error = await response.json().catch(() => ({}));
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: error.message || 'Something went wrong!',
        confirmButtonColor: '#4169E1'
      });
    }
  });
}
</script>