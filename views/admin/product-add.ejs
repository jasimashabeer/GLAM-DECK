<%- include("../../views/partials/admin/header") %>

<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

<style>
  * {
    box-sizing: border-box;
  }
  
  body {
    background: #f5f5f7;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
  }
  
  .error-message { 
    color: #dc3545; 
    font-size: 0.8125rem; 
    margin-top: 0.375rem; 
  }
  
  .content-main {
    padding: 0;
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 2rem 1.5rem 2rem;
    background: #f5f5f7;
  }
  
  .page-header h2 {
    font-size: 1.875rem;
    font-weight: 600;
    margin: 0;
    color: #1d1d1f;
  }
  
  .header-actions {
    display: flex;
    gap: 0.75rem;
  }
  
  .btn-publish {
    background: #5b67f1;
    color: white;
    border: none;
    padding: 0.6875rem 1.75rem;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  
  .btn-publish:hover {
    background: #4953d6;
  }
  
  .btn-draft {
    background: white;
    color: #3c3c43;
    border: 1px solid #d2d2d7;
    padding: 0.6875rem 1.75rem;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .btn-draft:hover {
    background: #fafafa;
    border-color: #b8b8bd;
  }
  
  .product-name-section {
    padding: 0 2rem 1.5rem 2rem;
    background: #f5f5f7;
  }
  
  .product-name-wrapper {
    position: relative;
    max-width: 500px;
  }
  
  .product-name-input {
    width: 100%;
    padding: 0.875rem 2.75rem 0.875rem 1rem;
    border: 2px solid #6b73ff;
    border-radius: 10px;
    font-size: 1rem;
    transition: border-color 0.2s;
    background: white;
  }
  
  .product-name-input:focus {
    outline: none;
    border-color: #5b67f1;
  }
  
  .dropdown-icon {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: #86868b;
    pointer-events: none;
  }
  
  .form-container {
    padding: 0 2rem 2rem 2rem;
    background: #f5f5f7;
  }
  
  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  
  .form-card {
    background: white;
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  
  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 1.5rem 0;
    color: #1d1d1f;
  }
  
  .form-group {
    margin-bottom: 1.5rem;
  }
  
  .form-group:last-child {
    margin-bottom: 0;
  }
  
  .form-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: #1d1d1f;
    margin-bottom: 0.5rem;
  }
  
  .form-input, .form-select, .form-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #d2d2d7;
    border-radius: 8px;
    font-size: 0.9375rem;
    transition: border-color 0.2s;
    background: white;
    color: #1d1d1f;
  }
  
  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: #6b73ff;
  }
  
  .form-textarea {
    resize: vertical;
    min-height: 120px;
    font-family: inherit;
  }
  
  .pricing-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  
  .input-icon-wrapper {
    position: relative;
  }
  
  .input-icon-wrapper input {
    padding-left: 2.25rem;
  }
  
  .icon-dollar {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: #86868b;
    font-weight: 500;
    font-size: 0.9375rem;
  }
  
  .icon-arrow {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: #86868b;
    pointer-events: none;
  }
  
  .upload-area {
    border: 2px dashed #d2d2d7;
    border-radius: 12px;
    padding: 2.5rem 1.5rem;
    text-align: center;
    background: #fafafa;
    cursor: pointer;
    transition: all 0.2s;
    margin-bottom: 1.25rem;
  }
  
  .upload-area:hover {
    border-color: #6b73ff;
    background: #f5f5ff;
  }
  
  .upload-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 1rem;
  }
  
  .upload-icon svg {
    width: 100%;
    height: 100%;
    color: #6b73ff;
  }
  
  .upload-text {
    font-size: 0.9375rem;
    color: #3c3c43;
    line-height: 1.5;
  }
  
  .upload-text strong {
    font-weight: 500;
  }
  
  #imagePreviewContainer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  
  .thumbnail-wrapper {
    position: relative;
    width: 110px;
    height: 110px;
  }
  
  .thumbnail-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid #e5e5e7;
  }
  
  .remove-image {
    position: absolute;
    top: -8px;
    right: -8px;
    background: #ff3b30;
    color: white;
    border-radius: 50%;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.125rem;
    font-weight: 500;
    border: 3px solid white;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }
  
  .remove-image:hover {
    background: #d32f2f;
  }
  
  .image-cropper {
    display: none;
    margin-top: 1.25rem;
    padding: 1.25rem;
    background: #fafafa;
    border-radius: 12px;
  }
  
  .image-cropper img {
    max-width: 100%;
    display: block;
    border-radius: 8px;
  }
  
  .btn-crop {
    background: #5b67f1;
    color: white;
    border: none;
    padding: 0.625rem 1.25rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    margin-top: 1rem;
  }
  
  .btn-crop:hover {
    background: #4953d6;
  }
  
  .tags-wrapper {
    position: relative;
  }
  
  .tags-input {
    width: 100%;
    padding: 0.75rem 2.5rem 0.75rem 1rem;
    border: 1px solid #d2d2d7;
    border-radius: 8px;
    font-size: 0.9375rem;
    background: white;
  }
  
  .tags-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: #86868b;
  }
  
  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  
  .tag {
    background: #f2f2f7;
    color: #3c3c43;
    padding: 0.4375rem 0.875rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    border: 1px solid #e5e5e7;
  }
  
  @media (max-width: 1200px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
  
  @media (max-width: 768px) {
    .page-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.5rem 1rem;
    }
    
    .product-name-section {
      padding: 0 1rem 1.5rem 1rem;
    }
    
    .form-container {
      padding: 0 1rem 1.5rem 1rem;
    }
    
    .pricing-row {
      grid-template-columns: 1fr;
    }
    
    .header-actions {
      width: 100%;
    }
    
    .btn-publish, .btn-draft {
      flex: 1;
    }
  }
</style>

<div class="content-main">
  <div class="page-header">
    <h2>Add New Product</h2>
    <div class="header-actions">
      <button type="button" class="btn-draft">Save as Draft</button>
      <button type="submit" form="productForm" class="btn-publish">Publish</button>
    </div>
  </div>

  <div class="product-name-section">
    <div class="product-name-wrapper">
      <input 
        type="text" 
        name="productName" 
        class="product-name-input" 
        placeholder="Product Name"
        form="productForm"
      />
      <svg class="dropdown-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div id="productName-error" class="error-message"></div>
  </div>

  <form id="productForm" method="POST" action="/admin/addProduct" enctype="multipart/form-data">
    
    <div class="form-container">
      <div class="form-grid">
        <!-- Product Information Card -->
        <div class="form-card">
          <h3 class="card-title">Product Information</h3>
          
          <div class="form-group">
            <label class="form-label">Product Name</label>
            <input name="productName_display" class="form-input" placeholder="Product Name" readonly style="background: #fafafa; cursor: not-allowed;" />
          </div>
          
          <div class="form-group">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-textarea" placeholder="Description"></textarea>
            <div id="description-error" class="error-message"></div>
          </div>
        </div>

        <!-- Pricing & Inventory Card -->
        <div class="form-card">
          <h3 class="card-title">Pricing & Inventory</h3>
          
          <div class="form-group">
            <label class="form-label">Regular Price</label>
            <div class="input-icon-wrapper">
              <span class="icon-dollar">₹</span>
              <input name="regularPrice" class="form-input" placeholder="Regular Price" />
              <svg class="icon-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div id="regularPrice-error" class="error-message"></div>
          </div>
          
          <div class="form-group">
            <label class="form-label">Quantity</label>
            <input name="quantity" class="form-input" placeholder="Quantity" />
            <div id="quantity-error" class="error-message"></div>
          </div>
        </div>

        <!-- Media Card -->
        <div class="form-card">
          <h3 class="card-title">Media</h3>
          
          <label for="uploadInput" class="upload-area">
            <div class="upload-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
              </svg>
            </div>
            <div class="upload-text">
              <strong>Drag and drop images here,</strong><br>
              <span style="color: #86868b;">or click to upload</span>
            </div>
          </label>
          
          <input 
            type="file" 
            id="uploadInput" 
            accept="image/*" 
            onchange="handleImage(this)"
            style="display: none;"
          />
          
          <div id="imagePreviewContainer"></div>
          <div id="images-error" class="error-message"></div>
          
          <div class="image-cropper">
            <img id="cropperPreview" />
            <button type="button" onclick="saveCroppedImage()" class="btn-crop">Crop & Save</button>
          </div>
        </div>

        <!-- Categorization Card -->
        <div class="form-card">
          <h3 class="card-title">Categorization</h3>
          
          <div class="form-group">
            <label class="form-label">Category</label>
            <div style="position: relative;">
              <select name="category" class="form-select" style="appearance: none; padding-right: 2.5rem;">
                <option value="">Necklace</option>
                <% cat.forEach(c => { %>
                  <option value="<%= c._id %>"><%= c.name %></option>
                <% }) %>
              </select>
              <svg class="icon-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div id="category-error" class="error-message"></div>
          </div>
          
          <div class="form-group">
            <label class="form-label">Material</label>
            <div class="tags-wrapper" style="position: relative;">
              <input name="material" class="form-input" placeholder="gold" style="padding-left: 2.5rem;" />
            
                <path d="M2 5L8 2L14 5M2 5L8 8M2 5V11L8 14M14 5L8 8M14 5V11L8 14M8 8V14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div id="material-error" class="error-message"></div>
            
            <div class="tags-container">
              <span class="tag">Gold</span>
              <span class="tag">Silver</span>
              <span class="tag">Rose Gold</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="hiddenImageInputs"></div>
  </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
let cropper;
let croppedBlobs = [];

// Sync product name
const mainInput = document.querySelector('.product-name-input');
const displayInput = document.querySelector('input[name="productName_display"]');

mainInput.addEventListener('input', function() {
  displayInput.value = this.value;
});

function handleImage(input) {
  if (!input.files.length) return;

  if (croppedBlobs.length >= 3) {
    Swal.fire("Limit Reached", "You can upload exactly 3 images", "warning");
    input.value = "";
    return;
  }

  const reader = new FileReader();
  reader.onload = () => {
    const image = document.getElementById("cropperPreview");
    image.src = reader.result;

    document.querySelector(".image-cropper").style.display = "block";

    if (cropper) cropper.destroy();
    cropper = new Cropper(image, { aspectRatio: 1, viewMode: 1 });
  };
  reader.readAsDataURL(input.files[0]);
}

function saveCroppedImage() {
  if (!cropper) return;

  cropper.getCroppedCanvas().toBlob(blob => {
    croppedBlobs.push(blob);
    addPreview(blob);

    cropper.destroy();
    cropper = null;

    const oldImg = document.getElementById("cropperPreview");
    const newImg = oldImg.cloneNode();
    newImg.src = "";
    oldImg.parentNode.replaceChild(newImg, oldImg);

    document.querySelector(".image-cropper").style.display = "none";
    document.getElementById("uploadInput").value = "";
  }, "image/jpeg");
}

function addPreview(blob) {
  const container = document.getElementById("imagePreviewContainer");

  const wrapper = document.createElement("div");
  wrapper.className = "thumbnail-wrapper";

  const img = document.createElement("img");
  img.src = URL.createObjectURL(blob);

  const removeBtn = document.createElement("div");
  removeBtn.className = "remove-image";
  removeBtn.innerHTML = "&times;";
  removeBtn.onclick = () => {
    const index = [...container.children].indexOf(wrapper);
    croppedBlobs.splice(index, 1);
    wrapper.remove();
  };

  wrapper.appendChild(img);
  wrapper.appendChild(removeBtn);
  container.appendChild(wrapper);
}

function validateForm() {
  let isValid = true;
  
  const productName = mainInput.value.trim();
  const productNameError = document.getElementById("productName-error");
  
  if (!productName) {
    productNameError.innerText = "Product name is required";
    isValid = false;
  } else {
    productNameError.innerText = "";
  }

  const fields = ["material", "description", "regularPrice", "quantity", "category"];

  fields.forEach(field => {
    const value = document.getElementsByName(field)[0].value.trim();
    const errorEl = document.getElementById(field + "-error");

    if (!value) {
      errorEl.innerText = `${field} is required`;
      isValid = false;
    } else {
      errorEl.innerText = "";
    }
  });

  const price = parseFloat(document.getElementsByName("regularPrice")[0].value);
  if (isNaN(price) || price <= 1) {
    document.getElementById("regularPrice-error").innerText = "Regular price must be greater than ₹1";
    isValid = false;
  }

  if (croppedBlobs.length !== 3) {
    document.getElementById("images-error").innerText = "Please upload exactly 3 images";
    isValid = false;
  } else {
    document.getElementById("images-error").innerText = "";
  }

  return isValid;
}

document.getElementById('productForm').addEventListener('submit', async function (e) {
    e.preventDefault();

    if (!validateForm()) return;

    if (cropper) {
        try {
            cropper.destroy();
        } catch (e) {
            console.error('Error destroying cropper:', e);
        }
        cropper = null;
    }
    
    const cropperContainer = document.querySelector(".image-cropper");
    if (cropperContainer) {
        cropperContainer.style.display = "none";
    }
    
    const previewImg = document.getElementById("cropperPreview");
    if (previewImg) {
        previewImg.src = "";
    }

    const form = e.target;
    const formData = new FormData();

    const productName = mainInput.value.trim();
    formData.append("productName", productName);

    ["material", "description", "regularPrice", "quantity", "category"]
        .forEach(field => {
            formData.append(field, form[field].value);
        });

    if (croppedBlobs.length !== 3) {
        Swal.fire("Error", "Please upload exactly 3 images", "error");
        return;
    }

    croppedBlobs.forEach((blob, index) => {
        formData.append("images", blob, `product-${index + 1}.jpg`);
    });

    const response = await fetch('/admin/addProduct', {
        method: 'POST',
        body: formData
    });

    if (response.ok) {
        if (cropper) {
            try {
                cropper.destroy();
            } catch (e) {
                console.error('Error destroying cropper:', e);
            }
            cropper = null;
        }
        
        const cropperContainer = document.querySelector(".image-cropper");
        if (cropperContainer) {
            cropperContainer.style.display = "none";
            const previewImg = document.getElementById("cropperPreview");
            if (previewImg) {
                previewImg.src = "";
            }
        }
        
        const uploadInput = document.getElementById("uploadInput");
        if (uploadInput) {
            uploadInput.value = "";
        }
        
        croppedBlobs = [];
        
        Swal.fire("Success", "Product added successfully!", "success")
            .then(() => window.location.reload());
    } else {
        const error = await response.json().catch(() => ({}));
        Swal.fire("Error", error.message || "Something went wrong!", "error");
    }
});
</script>