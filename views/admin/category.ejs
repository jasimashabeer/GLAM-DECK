<%- include("../../views/partials/admin/header") %>

  <head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
      /* ========== GLOBAL ADMIN LAYOUT STYLES ========== */
      body {
        background: #f5f6fa;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }

      .admin-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
      }

      /* ========== HEADER SECTION ========== */
      .page-header {
        background: white;
        border-radius: 20px;
        padding: 2rem 2.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }

      .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
      }

      /* ========== SEARCH SECTION ========== */
      .search-card {
        background: white;
        border-radius: 20px;
        padding: 2rem 2.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }

      .search-container {
        max-width: 600px;
        margin: 0 auto;
      }

      .search-wrapper {
        display: flex;
        align-items: center;
        background: #f8f9fa;
        border-radius: 14px;
        padding: 0.5rem 1rem;
        transition: all 0.3s ease;
      }

      .search-wrapper:focus-within {
        background: white;
        box-shadow: 0 0 0 3px rgba(65, 105, 225, 0.1);
      }

      .search-icon {
        color: #6c757d;
        margin-right: 0.75rem;
      }

      .search-input {
        flex: 1;
        border: none;
        background: transparent;
        padding: 0.75rem 0;
        font-size: 0.9375rem;
        outline: none;
        color: #1a1a1a;
      }

      .search-input::placeholder {
        color: #adb5bd;
      }

      .btn-search {
        background: #4169E1;
        color: white;
        border: none;
        padding: 0.625rem 1.25rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        margin-left: 0.5rem;
        transition: all 0.2s ease;
      }

      .btn-search:hover {
        background: #3557c7;
      }

      .btn-clear {
        background: #e9ecef;
        color: #495057;
        border: none;
        padding: 0.625rem 1.25rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        margin-left: 0.5rem;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-block;
      }

      .btn-clear:hover {
        background: #dee2e6;
        color: #495057;
      }

      /* ========== CREATE CATEGORY SECTION ========== */
      .create-category-card {
        background: white;
        border-radius: 20px;
        padding: 2.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }

      .create-category-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 2rem;
        text-align: center;
      }

      .create-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 1.5rem;
        align-items: end;
      }

      .create-form-group {
        display: flex;
        flex-direction: column;
      }

      .form-label-modern {
        font-size: 0.875rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
      }

      .form-input-modern {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 1px solid #d2d2d7;
        border-radius: 10px;
        font-size: 0.9375rem;
        transition: all 0.2s ease;
        background: white;
        color: #1a1a1a;
      }

      .form-input-modern::placeholder {
        color: #adb5bd;
      }

      .form-input-modern:focus {
        outline: none;
        border-color: #4169E1;
        box-shadow: 0 0 0 3px rgba(65, 105, 225, 0.1);
      }

      .error-message {
        color: #dc3545;
        font-size: 0.8125rem;
        margin-top: 0.375rem;
        display: none;
      }

      .btn-create {
        background: #4169E1;
        color: white;
        border: none;
        padding: 0.875rem 2rem;
        border-radius: 10px;
        font-size: 0.9375rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
      }

      .btn-create:hover {
        background: #3557c7;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(65, 105, 225, 0.3);
      }

      /* ========== TABLE CARD ========== */
      .table-card {
        background: white;
        border-radius: 20px;
        padding: 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        overflow: hidden;
        margin-bottom: 2rem;
      }

      .modern-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0;
      }

      .modern-table thead {
        background: #f8f9fa;
      }

      .modern-table thead th {
        padding: 1.25rem 1.5rem;
        text-align: left;
        font-size: 0.8125rem;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e9ecef;
      }

      .modern-table tbody tr {
        transition: all 0.2s ease;
        border-bottom: 1px solid #f1f3f5;
      }

      .modern-table tbody tr:hover {
        background: #f8f9ff;
      }

      .modern-table tbody tr:last-child {
        border-bottom: none;
      }

      .modern-table tbody td {
        padding: 1.25rem 1.5rem;
        font-size: 0.9375rem;
        color: #495057;
        vertical-align: middle;
      }

      .category-name-cell {
        font-weight: 600;
        color: #1a1a1a;
      }

      .offer-badge {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-block;
      }

      .no-offer-badge {
        background: #e9ecef;
        color: #6c757d;
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
      }

      /* ========== STATUS BADGES ========== */
      .status-badge {
        padding: 0.4rem 0.85rem;
        border-radius: 8px;
        font-size: 0.8125rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
      }

      .status-listed {
        background: #d4edda;
        color: #155724;
      }

      .status-unlisted {
        background: #f8d7da;
        color: #721c24;
      }

      /* ========== BUTTONS ========== */
      .btn-modern {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.8125rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
      }

      .btn-primary-modern {
        background: #4169E1;
        color: white;
      }

      .btn-primary-modern:hover {
        background: #3557c7;
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(65, 105, 225, 0.25);
        color: white;
      }

      .btn-success-modern {
        background: #28a745;
        color: white;
      }

      .btn-success-modern:hover {
        background: #218838;
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(40, 167, 69, 0.25);
        color: white;
      }

      .btn-danger-modern {
        background: #dc3545;
        color: white;
      }

      .btn-danger-modern:hover {
        background: #c82333;
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(220, 53, 69, 0.25);
        color: white;
      }

      .btn-info-modern {
        background: #17a2b8;
        color: white;
      }

      .btn-info-modern:hover {
        background: #138496;
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(23, 162, 184, 0.25);
        color: white;
      }

      /* ========== PAGINATION ========== */
      .pagination-modern {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        margin-top: 2rem;
        padding: 1.5rem;
      }

      .pagination-modern .page-item {
        list-style: none;
      }

      .pagination-modern .page-link {
        padding: 0.625rem 1rem;
        border-radius: 10px;
        border: 2px solid transparent;
        background: white;
        color: #495057;
        font-weight: 500;
        font-size: 0.9375rem;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-block;
        min-width: 42px;
        text-align: center;
      }

      .pagination-modern .page-link:hover {
        background: #f8f9fa;
        border-color: #e9ecef;
        color: #1a1a1a;
      }

      .pagination-modern .current-page {
        padding: 0.625rem 1rem;
        border-radius: 10px;
        background: #4169E1;
        color: white;
        border: 2px solid #4169E1;
        box-shadow: 0 4px 8px rgba(65, 105, 225, 0.25);
        font-weight: 500;
        font-size: 0.9375rem;
        min-width: 42px;
        text-align: center;
        display: inline-block;
      }

      /* ========== RESPONSIVE DESIGN ========== */
      @media (max-width: 1200px) {
        .create-form-row {
          grid-template-columns: 1fr;
          gap: 1.25rem;
        }

        .btn-create {
          width: 100%;
        }
      }

      @media (max-width: 992px) {
        .admin-container {
          padding: 1.5rem;
        }

        .page-header,
        .search-card,
        .create-category-card {
          padding: 1.5rem;
        }

        .page-title {
          font-size: 1.5rem;
        }

        .modern-table {
          font-size: 0.875rem;
        }

        .modern-table thead th,
        .modern-table tbody td {
          padding: 1rem;
        }
      }

      @media (max-width: 768px) {
        .admin-container {
          padding: 1rem;
        }

        .page-header,
        .search-card,
        .create-category-card {
          padding: 1.5rem;
          border-radius: 16px;
        }

        .modern-table {
          display: block;
          overflow-x: auto;
          white-space: nowrap;
        }

        .btn-modern {
          padding: 0.4rem 0.75rem;
          font-size: 0.75rem;
        }
      }
    </style>
  </head>

  <div class="admin-container">
    <!-- Page Header -->
    <div class="page-header">
      <h1 class="page-title">Category Management</h1>
    </div>

    <!-- Search Section -->
    <div class="search-card">
      <form action="/admin/category" method="get">
        <div class="search-container">
          <div class="search-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input type="text" class="search-input" placeholder="Search categories..." name="search"
              value="<%= typeof search !== 'undefined' ? search : '' %>" />
            <button class="btn-search" type="submit">Search</button>
            <% if (typeof search !=='undefined' && search.trim() !=='' ) { %>
              <a href="/admin/category" class="btn-clear">Clear</a>
              <% } %>
          </div>
        </div>
      </form>
    </div>

    <!-- Create Category Section -->
    <div class="create-category-card">
      <h2 class="create-category-title">Create New Category</h2>
      <form method="post" action="/admin/addCategory" onsubmit="return handleFormSubmit(event)">
        <div class="create-form-row">
          <div class="create-form-group">
            <label for="product_name" class="form-label-modern">
              <i class="bi bi-tag"></i> Category Name
            </label>
            <input type="text" name="name" placeholder="Enter category name..." class="form-input-modern"
              id="product_name" />
            <div id="name-error" class="error-message"></div>
          </div>

          <div class="create-form-group">
            <label class="form-label-modern">
              <i class="bi bi-card-text"></i> Description
            </label>
            <input type="text" placeholder="Enter description..." name="description" class="form-input-modern"
              id="descriptionId" />
            <div id="description-error" class="error-message"></div>
          </div>

          <div class="create-form-group">
            <button class="btn-create" type="submit">
              <i class="bi bi-plus-circle"></i> Create Category
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- Categories Table -->
    <div class="table-card">
      <table class="modern-table">
        <thead>
          <tr>
            <th>Category Name</th>
            <th>Description</th>
            <th>Offer</th>
            <th>Manage Offer</th>
            <th>Status</th>
            <th>List/Unlist</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% cat.reverse().forEach((category, index)=> { %>
            <tr>
              <!-- Category Name -->
              <td class="category-name-cell">
                <i class="bi bi-folder"></i>
                <%= category.name %>
              </td>

              <!-- Description -->
              <td>
                <%= category.description %>
              </td>

              <!-- Offer Badge -->
              <td>
                <% if (category.categoryOffer && category.categoryOffer> 0) { %>
                  <span class="offer-badge">
                    <%= category.categoryOffer %>% OFF
                  </span>
                  <% } else { %>
                    <span class="no-offer-badge">No Offer</span>
                    <% } %>
              </td>

              <!-- Manage Offer Button -->
              <td>
                <% if (!category.categoryOffer || category.categoryOffer==0) { %>
                  <button class="btn-modern btn-info-modern" onclick="addOffer('<%= category._id %>')">
                    <i class="bi bi-tag"></i> Add Offer
                  </button>
                  <% } else { %>
                    <button class="btn-modern btn-danger-modern" onclick="removeOffer('<%= category._id %>')">
                      <i class="bi bi-x-circle"></i> Remove
                    </button>
                    <% } %>
              </td>

              <!-- Status Badge -->
              <td>
                <% if (category.isListed) { %>
                  <span class="status-badge status-listed">
                    <i class="bi bi-check-circle-fill"></i> Listed
                  </span>
                  <% } else { %>
                    <span class="status-badge status-unlisted">
                      <i class="bi bi-x-circle-fill"></i> Unlisted
                    </span>
                    <% } %>
              </td>

              <!-- List/Unlist Action -->
              <td>
                <% if (category.isListed) { %>
                  <a href="/admin/listCategory?id=<%= category._id %>" class="btn-modern btn-danger-modern">
                    <i class="bi bi-eye-slash"></i> Unlist
                  </a>
                  <% } else { %>
                    <a href="/admin/unlistCategory?id=<%= category._id %>" class="btn-modern btn-success-modern">
                      <i class="bi bi-eye"></i> List
                    </a>
                    <% } %>
              </td>

              <!-- Actions (Edit & Delete) -->
              <td>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                  <a href="/admin/editCategory?id=<%= category._id %>" class="btn-modern btn-primary-modern">
                    <i class="bi bi-pencil-square"></i> Edit
                  </a>
                  <button class="btn-modern btn-danger-modern" onclick="deleteCategory('<%= category._id %>')">
                    <i class="bi bi-trash"></i> Delete
                  </button>
                </div>
              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="pagination-modern">
      <% if (currentPage> 1) { %>
        <a href="?page=<%= currentPage - 1 %>" class="page-link">
          <i class="bi bi-chevron-left"></i> Previous
        </a>
        <% } %>

          <% for (let i=1; i <=totalPages; i++) { %>
            <% if (i===currentPage) { %>
              <span class="current-page">
                <%= i %>
              </span>
              <% } else { %>
                <a href="?page=<%= i %>" class="page-link">
                  <%= i %>
                </a>
                <% } %>
                  <% } %>

                    <% if (currentPage < totalPages) { %>
                      <a href="?page=<%= currentPage + 1 %>" class="page-link">
                        Next <i class="bi bi-chevron-right"></i>
                      </a>
                      <% } %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

  <script>
    function handleFormSubmit(event) {
      event.preventDefault();
      if (!validateForm()) {
        return;
      }
      const name = document.getElementsByName('name')[0].value;
      const description = document.getElementById('descriptionId').value;

      fetch('/admin/addCategory', {
        method: 'POST',
        headers: {
          'content-type': 'application/json'
        },
        body: JSON.stringify({ name, description })
      })
        .then(response => {
          if (!response.ok) {
            return response.json().then(err => {
              throw new Error(err.error)
            })
          }
          return response.json();
        })
        .then(data => {
          Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: data.message || 'Category added successfully',
            confirmButtonColor: '#4169E1'
          }).then(() => {
            location.reload();
          });
        })
        .catch(error => {
          if (error.message === 'Category already exist') {
            Swal.fire({
              icon: 'error',
              title: 'Oops',
              text: 'Category already exists',
              confirmButtonColor: '#4169E1'
            })
          } else {
            Swal.fire({
              icon: 'error',
              title: 'Oops',
              text: 'An error occurred while adding the category',
              confirmButtonColor: '#4169E1'
            })
          }
        })
    }

    function validateForm() {
      clearErrorMessages();
      const name = document.getElementsByName('name')[0].value.trim();
      const description = document.getElementById('descriptionId').value.trim();
      let isValid = true;

      if (name === '') {
        displayErrorMessage('name-error', 'Please enter a name');
        isValid = false;
      }

      if (description === '') {
        displayErrorMessage("description-error", "Please enter a description");
        isValid = false;
      }

      return isValid;
    }

    function displayErrorMessage(elementId, message) {
      var errorElement = document.getElementById(elementId)
      errorElement.innerText = message
      errorElement.style.display = 'block';
    }

    function clearErrorMessages() {
      const errorElements = document.getElementsByClassName('error-message')
      Array.from(errorElements).forEach((element) => {
        element.innerText = '';
        element.style.display = 'none';
      })
    }

    async function addOffer(categoryId) {
      const { value: amount } = await Swal.fire({
        title: 'Add Category Offer',
        input: 'number',
        inputLabel: 'Discount Percentage',
        inputPlaceholder: 'Enter percentage (e.g., 10)',
        inputAttributes: { min: 1, max: 90 },
        showCancelButton: true,
        confirmButtonColor: '#4169E1',
        cancelButtonColor: '#6c757d',
      });

      if (amount) {
        try {
          const response = await fetch('/admin/addCategoryOffer', {
            method: 'POST',
            headers: {
              'content-type': "application/json",
            },
            body: JSON.stringify({
              percentage: amount,
              categoryId: categoryId,
            }),
          });

          const data = await response.json()
          if (response.ok && data.status === true) {
            Swal.fire({
              icon: 'success',
              title: 'Offer Added!',
              text: 'The offer has been added successfully',
              confirmButtonColor: '#4169E1'
            }).then(() => {
              location.reload()
            })
          } else {
            Swal.fire({
              icon: 'error',
              title: 'Failed',
              text: data.message || "Adding offer failed",
              confirmButtonColor: '#4169E1'
            })
          }
        } catch (error) {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An error occurred while adding the offer',
            confirmButtonColor: '#4169E1'
          })
          console.log("error adding offer", error)
        }
      }
    }

    async function removeOffer(categoryId) {
      const result = await Swal.fire({
        title: 'Remove Offer?',
        text: 'This will remove the discount from this category',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, remove it'
      });

      if (!result.isConfirmed) return;

      try {
        const response = await fetch('/admin/removeCategoryOffer', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            categoryId: categoryId,
          })
        })

        const data = await response.json()
        if (response.ok && data.status === true) {
          Swal.fire({
            icon: 'success',
            title: 'Offer Removed!',
            text: 'The offer has been removed successfully',
            confirmButtonColor: '#4169E1'
          }).then(() => {
            location.reload()
          })
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Failed',
            text: data.message || "Removing offer failed",
            confirmButtonColor: '#4169E1'
          })
        }
      } catch (error) {
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'An error occurred while removing the offer',
          confirmButtonColor: '#4169E1'
        })
        console.error("Error removing offer", error)
      }
    }

    async function deleteCategory(categoryId) {
      const result = await Swal.fire({
        title: 'Are you sure?',
        text: "Do you really want to delete this category?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, delete it!'
      });

      if (result.isConfirmed) {
        try {
          const response = await fetch(`/admin/deleteCategory/${categoryId}`, {
            method: 'DELETE',
          });

          const data = await response.json();

          if (response.ok && data.status === true) {
            Swal.fire({
              icon: 'success',
              title: 'Deleted!',
              text: 'The category has been deleted.',
              confirmButtonColor: '#4169E1'
            }).then(() => {
              location.reload();
            });
          } else {
            Swal.fire({
              icon: 'error',
              title: 'Failed',
              text: data.message || 'Deletion failed.',
              confirmButtonColor: '#4169E1'
            });
          }
        } catch (error) {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'An error occurred during deletion.',
            confirmButtonColor: '#4169E1'
          });
          console.error('Error deleting category:', error);
        }
      }
    }
  </script>