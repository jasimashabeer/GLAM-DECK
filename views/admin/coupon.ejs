<%- include('../partials/admin/header') %>

  <style>
    :root {
      --primary-color: #4F46E5;
      --primary-hover: #4338CA;
      --success-color: #10B981;
      --danger-color: #EF4444;
      --warning-color: #F59E0B;
      --border-color: #E5E7EB;
      --text-primary: #111827;
      --text-secondary: #6B7280;
      --bg-gray: #F9FAFB;
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    body {
      background-color: #F3F4F6;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }

    .page-header {
      background: white;
      padding: 2rem 0;
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--border-color);
    }

    .page-title {
      font-size: 1.875rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0;
    }

    .modern-card {
      background: white;
      border-radius: 12px;
      border: 1px solid var(--border-color);
      box-shadow: var(--shadow-sm);
      transition: all 0.3s ease;
    }

    .modern-card:hover {
      box-shadow: var(--shadow-md);
    }

    .card-header-modern {
      padding: 1.5rem;
      border-bottom: 1px solid var(--border-color);
    }

    .card-title-modern {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0;
    }

    .card-body-modern {
      padding: 1.5rem;
    }

    .form-group-modern {
      margin-bottom: 1.5rem;
    }

    .form-label-modern {
      display: block;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
    }

    .form-control-modern {
      width: 100%;
      padding: 0.625rem 0.875rem;
      font-size: 0.875rem;
      border: 1.5px solid var(--border-color);
      border-radius: 8px;
      transition: all 0.2s ease;
      background-color: white;
      color: var(--text-primary);
    }

    .form-control-modern:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }

    .form-control-modern::placeholder {
      color: #9CA3AF;
    }

    .error-message {
      font-size: 0.75rem;
      color: var(--danger-color);
      margin-top: 0.375rem;
      display: block;
    }

    .btn-modern {
      padding: 0.625rem 1.25rem;
      font-size: 0.875rem;
      font-weight: 500;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .btn-primary-modern {
      background-color: var(--primary-color);
      color: white;
    }

    .btn-primary-modern:hover {
      background-color: var(--primary-hover);
      transform: translateY(-1px);
      box-shadow: var(--shadow-md);
    }

    .btn-success-modern {
      background-color: var(--success-color);
      color: white;
    }

    .btn-success-modern:hover {
      background-color: #059669;
      transform: translateY(-1px);
    }

    .btn-danger-modern {
      background-color: var(--danger-color);
      color: white;
    }

    .btn-danger-modern:hover {
      background-color: #DC2626;
    }

    .btn-full {
      width: 100%;
    }

    .btn-sm-modern {
      padding: 0.375rem 0.75rem;
      font-size: 0.8125rem;
    }

    .alert-modern {
      padding: 0.875rem 1rem;
      border-radius: 8px;
      margin-bottom: 1rem;
      font-size: 0.875rem;
      border-left: 4px solid;
    }

    .alert-danger-modern {
      background-color: #FEF2F2;
      border-color: var(--danger-color);
      color: #991B1B;
    }

    .table-modern {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }

    .table-modern thead th {
      background-color: var(--bg-gray);
      padding: 0.875rem 1rem;
      text-align: left;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--border-color);
    }

    .table-modern thead th:first-child {
      border-top-left-radius: 8px;
    }

    .table-modern thead th:last-child {
      border-top-right-radius: 8px;
    }

    .table-modern tbody td {
      padding: 1rem;
      font-size: 0.875rem;
      color: var(--text-primary);
      border-bottom: 1px solid var(--border-color);
    }

    .table-modern tbody tr:last-child td {
      border-bottom: none;
    }

    .table-modern tbody tr:hover {
      background-color: var(--bg-gray);
    }

    .badge-modern {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      font-size: 0.75rem;
      font-weight: 500;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.025em;
    }

    .badge-success {
      background-color: #D1FAE5;
      color: #065F46;
    }

    .badge-danger {
      background-color: #FEE2E2;
      color: #991B1B;
    }

    .table-actions {
      display: flex;
      gap: 0.5rem;
      justify-content: center;
    }

    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--text-secondary);
    }

    .empty-state-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
      opacity: 0.3;
    }

    @media (max-width: 768px) {
      .table-modern {
        font-size: 0.8125rem;
      }

      .table-modern thead th,
      .table-modern tbody td {
        padding: 0.625rem 0.5rem;
      }

      .btn-sm-modern {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
      }

      .table-actions {
        flex-direction: column;
      }
    }

    .input-group-modern {
      position: relative;
    }

    .input-icon {
      position: absolute;
      left: 0.875rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-secondary);
      font-size: 1rem;
    }

    .form-control-modern.with-icon {
      padding-left: 2.5rem;
    }
  </style>

  <div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
      <h1 class="page-title mb-0">Coupon Management</h1>
      <% if (!editCoupon) { %>
        <button type="button" class="btn-modern btn-primary-modern" data-bs-toggle="modal"
          data-bs-target="#couponModal">
          Create Coupon
        </button>
        <% } %>
    </div>
  </div>

  <div class="container mb-5">
    <div class="row g-4">
      <!-- Edit Coupon Form (shown only in edit mode, not in modal) -->
      <% if (editCoupon) { %>
        <div class="col-lg-4">
          <div class="modern-card">
            <div class="card-header-modern">
              <h5 class="card-title-modern">
                Edit Coupon
              </h5>
            </div>
            <div class="card-body-modern">
              <form action="/admin/coupons/update/<%= editCoupon._id %>" method="POST" onsubmit="return validateForm()">

                <div class="form-group-modern">
                  <label class="form-label-modern">Coupon Name</label>
                  <input type="text" id="couponName" name="couponName" class="form-control-modern"
                    placeholder="e.g., SUMMER2024" value="<%= editCoupon.couponName %>">
                  <span class="error-message" id="couponNameError"></span>
                </div>

                <div class="form-group-modern">
                  <label class="form-label-modern">Start Date</label>
                  <input type="date" id="startDate" name="startDate" class="form-control-modern"
                    value="<%= editCoupon.startDate.toISOString().split('T')[0] %>">
                  <span class="error-message" id="startDateError"></span>
                </div>

                <div class="form-group-modern">
                  <label class="form-label-modern">End Date</label>
                  <input type="date" id="endDate" name="endDate" class="form-control-modern"
                    value="<%= editCoupon.endDate.toISOString().split('T')[0] %>">
                  <span class="error-message" id="endDateError"></span>
                </div>

                <div class="form-group-modern">
                  <label class="form-label-modern">Offer Price</label>
                  <div class="input-group-modern">
                    <span class="input-icon">₹</span>
                    <input type="number" id="offerPrice" name="offerPrice" class="form-control-modern with-icon"
                      placeholder="0.00" value="<%= editCoupon.offerPrice %>" min="1">
                  </div>
                  <span class="error-message" id="offerPriceError"></span>
                </div>

                <div class="form-group-modern">
                  <label class="form-label-modern">Minimum Purchase Amount</label>
                  <div class="input-group-modern">
                    <span class="input-icon">₹</span>
                    <input type="number" id="minimumPrice" name="minimumPrice" class="form-control-modern with-icon"
                      placeholder="0.00" value="<%= editCoupon.minimumPrice %>" min="1">
                  </div>
                  <span class="error-message" id="minimumPriceError"></span>
                </div>

                <% if (errorMsg && errorMsg.trim() !=='' ) { %>
                  <div class="alert-modern alert-danger-modern">
                    <%= errorMsg %>
                  </div>
                  <% } %>

                    <button type="submit" class="btn-modern btn-primary-modern btn-full">
                      Update Coupon
                    </button>
              </form>
            </div>
          </div>
        </div>
        <% } %>

          <!-- Coupon Table -->
          <div class="<%= editCoupon ? 'col-lg-8' : 'col-12' %>">
            <div class="modern-card">
              <div class="card-header-modern">
                <h5 class="card-title-modern">All Coupons</h5>
              </div>
              <div class="card-body-modern" style="padding: 0;">
                <% if (coupons && coupons.length> 0) { %>
                  <div class="table-responsive">
                    <table class="table-modern">
                      <thead>
                        <tr>
                          <th>Name</th>
                          <th>Start Date</th>
                          <th>End Date</th>
                          <th>Offer</th>
                          <th>Minimum </th>
                          <th>Status</th>
                          <th style="text-align: center;">Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% coupons.forEach(coupon=> { %>
                          <tr>
                            <td style="font-weight: 500;">
                              <%= coupon.couponName %>
                            </td>
                            <td>
                              <%= coupon.startDate.toLocaleDateString() %>
                            </td>
                            <td>
                              <%= coupon.endDate.toLocaleDateString() %>
                            </td>
                            <td>₹<%= coupon.offerPrice %>
                            </td>
                            <td>₹<%= coupon.minimumPrice %>
                            </td>
                            <td>
                              <% if (new Date()> new Date(coupon.endDate)) { %>
                                <span class="badge-modern badge-danger">Expired</span>
                                <% } else { %>
                                  <span class="badge-modern badge-success">Active</span>
                                  <% } %>
                            </td>
                            <td>
                              <div class="table-actions">
                                <a href="/admin/coupons/edit/<%= coupon._id %>"
                                  class="btn-modern btn-success-modern btn-sm-modern">
                                  Edit
                                </a>
                                <button class="btn-modern btn-danger-modern btn-sm-modern"
                                  onclick="deleteCoupon('<%= coupon._id %>')">
                                  Delete
                                </button>
                              </div>
                            </td>
                          </tr>
                          <% }) %>
                      </tbody>
                    </table>
                  </div>
                  <% } else { %>
                    <div class="empty-state">
                      <div class="empty-state-icon">🎫</div>
                      <p style="font-size: 1rem; font-weight: 500; margin-bottom: 0.5rem;">No coupons available</p>
                      <p style="font-size: 0.875rem; margin: 0;">Create your first coupon to get started</p>
                    </div>
                    <% } %>
              </div>
            </div>
          </div>
    </div>
  </div>

  <!-- Create Coupon Modal (used when not editing) -->
  <% if (!editCoupon) { %>
    <div class="modal fade" id="couponModal" tabindex="-1" aria-labelledby="couponModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="couponModalLabel">Create Coupon</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="modern-card border-0 shadow-none">
              <div class="card-body-modern">
                <form action="/admin/createCoupon" method="POST" onsubmit="return validateForm()">

                  <div class="form-group-modern">
                    <label class="form-label-modern">Coupon Name</label>
                    <input type="text" id="couponName" name="couponName" class="form-control-modern"
                      placeholder="e.g., SUMMER2024">
                    <span class="error-message" id="couponNameError"></span>
                  </div>

                  <div class="form-group-modern">
                    <label class="form-label-modern">Start Date</label>
                    <input type="date" id="startDate" name="startDate" class="form-control-modern">
                    <span class="error-message" id="startDateError"></span>
                  </div>

                  <div class="form-group-modern">
                    <label class="form-label-modern">End Date</label>
                    <input type="date" id="endDate" name="endDate" class="form-control-modern">
                    <span class="error-message" id="endDateError"></span>
                  </div>

                  <div class="form-group-modern">
                    <label class="form-label-modern">Offer Price</label>
                    <div class="input-group-modern">
                      <span class="input-icon">₹</span>
                      <input type="number" id="offerPrice" name="offerPrice" class="form-control-modern with-icon"
                        placeholder="0.00" min="1">
                    </div>
                    <span class="error-message" id="offerPriceError"></span>
                  </div>

                  <div class="form-group-modern">
                    <label class="form-label-modern">Minimum Purchase Amount</label>
                    <div class="input-group-modern">
                      <span class="input-icon">₹</span>
                      <input type="number" id="minimumPrice" name="minimumPrice" class="form-control-modern with-icon"
                        placeholder="0.00" min="1">
                    </div>
                    <span class="error-message" id="minimumPriceError"></span>
                  </div>

                  <% if (errorMsg && errorMsg.trim() !=='' ) { %>
                    <div class="alert-modern alert-danger-modern">
                      <%= errorMsg %>
                    </div>
                    <% } %>

                      <button type="submit" class="btn-modern btn-success-modern btn-full">
                        Add Coupon
                      </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

      <!-- Frontend Validation -->
      <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
      <!-- Bootstrap JS bundle for modal behavior -->
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

      <script>
        function validateForm() {
          let valid = true;

          // Clear previous errors
          document.querySelectorAll('.error-message').forEach(el => el.textContent = '');

          const name = document.getElementById('couponName').value.trim();
          const start = document.getElementById('startDate').value;
          const end = document.getElementById('endDate').value;
          const offer = +document.getElementById('offerPrice').value;
          const min = +document.getElementById('minimumPrice').value;

          if (!name) {
            document.getElementById('couponNameError').textContent = 'Coupon name is required';
            valid = false;
          }

          if (!start) {
            document.getElementById('startDateError').textContent = 'Start date is required';
            valid = false;
          }

          if (!end) {
            document.getElementById('endDateError').textContent = 'End date is required';
            valid = false;
          } else if (new Date(end) < new Date(start)) {
            document.getElementById('endDateError').textContent = 'End date must be after start date';
            valid = false;
          }

          if (!offer || offer <= 0) {
            document.getElementById('offerPriceError').textContent = 'Offer price must be greater than 0';
            valid = false;
          }

          if (!min || min <= 0) {
            document.getElementById('minimumPriceError').textContent = 'Minimum price must be greater than 0';
            valid = false;
          } else if (offer >= min) {
            document.getElementById('minimumPriceError').textContent = 'Minimum price must be greater than offer price';
            valid = false;
          }

          return valid;
        }
      </script>

      <script>
        function deleteCoupon(couponId) {
          Swal.fire({
            title: 'Are you sure?',
            text: 'This coupon will be permanently deleted!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#EF4444',
            cancelButtonColor: '#6B7280',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
          }).then((result) => {
            if (result.isConfirmed) {
              fetch(`/admin/coupons/${couponId}`, {
                method: 'DELETE',
                headers: {
                  'Content-Type': 'application/json'
                }
              })
                .then(res => res.json())
                .then(data => {
                  if (data.ok) {
                    Swal.fire({
                      title: 'Deleted!',
                      text: 'Coupon has been deleted.',
                      icon: 'success',
                      confirmButtonColor: '#10B981'
                    }).then(() => {
                      location.reload();
                    });
                  } else {
                    Swal.fire({
                      title: 'Error',
                      text: data.msg || 'Failed to delete',
                      icon: 'error',
                      confirmButtonColor: '#EF4444'
                    });
                  }
                })
                .catch(err => {
                  console.error(err);
                  Swal.fire({
                    title: 'Error',
                    text: 'Something went wrong',
                    icon: 'error',
                    confirmButtonColor: '#EF4444'
                  });
                });
            }
          });
        }
      </script>