 <%- include("../../views/partials/admin/header") %>
<%- include("../../views/partials/admin/sidebar") %>



<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Product - Admin Panel</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/viewproduct.css">
</head>
<body>
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <a href="/admin/dashboard" class="sidebar-brand">
        <i class="fas fa-shield-halved"></i>
        <span>Admin Panel</span>
      </a>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section-title">Main Navigation</div>
      <a href="/admin/dashboard" class="sidebar-link">
        <i class="fas fa-chart-line"></i>
        <span>Dashboard</span>
      </a>
      <a href="/admin/users" class="sidebar-link">
        <i class="fas fa-users"></i>
        <span>Customer Management</span>
      </a>
      <a href="/admin/category" class="sidebar-link">
        <i class="fas fa-folder"></i>
        <span>Category Management</span>
      </a>
      <a href="/admin/getproduct" class="sidebar-link active">
        <i class="fas fa-box"></i>
        <span>Products Management</span>
      </a>
      <a href="/admin/offers" class="sidebar-link">
        <i class="fas fa-tag"></i>
        <span>Offer Management</span>
      </a>
      <a href="/admin/orders" class="sidebar-link">
        <i class="fas fa-shopping-cart"></i>
        <span>Orders Management</span>
      </a>
      <a href="/admin/reports" class="sidebar-link">
        <i class="fas fa-file-chart"></i>
        <span>Reports</span>
      </a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="main-content">
    <!-- Top Bar -->
    <div class="top-bar">
      <div>
        <h1 class="page-title">
          <i class="fas fa-box-open"></i>
          Product Details
        </h1>
        <div class="breadcrumb">
          <a href="/admin/dashboard">Dashboard</a>
          <span>/</span>
          <a href="/admin/getproduct">Products</a>
          <span>/</span>
          <span>View Product</span>
        </div>
      </div>
      <a href="/admin/getproduct" class="btn-back">
        <i class="fas fa-arrow-left"></i>
        Back to Products
      </a>
    </div>

    <!-- Content Grid -->
    <div class="content-grid">
      <!-- Image Gallery -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fas fa-images"></i>
            Product Images
          </h3>
        </div>
        <div class="card-body">
          <div class="image-gallery">
            <!-- Main Image -->
            <div class="main-image-container" onclick="openZoom(0)">
              <img src="<%= product.image[0] %>" alt="<%= product.name %>" class="main-image" id="mainImage">
              <div class="zoom-icon">
                <i class="fas fa-search-plus"></i>
              </div>
            </div>

            <!-- Thumbnails -->
<% if (product.image && product.image.length > 1) { %>
  <div class="thumbnail-grid">
    <% product.image.forEach(function(img, index) { %>
      <div class='thumbnail <%= index === 0 ? "active" : "" %>' onclick='changeMainImage("<%= img %>", <%= index %>)'>
        <img src="<%= img %>" alt="Product Image <%= index + 1 %>">
      </div>
    <% }); %>
  </div>
<% } %>




            <!-- <% if (product.image.length > 1) { %>
              <div class="thumbnail-grid">
                <% product.image.forEach((img, index) => { %>
                  <div class="thumbnail <%= index === 0 ? 'active' : '' %>" onclick="changeMainImage('<%= img %>', <%= index %>)">
                    <img src="<%= img %>" alt="Product Image <%= index + 1 %>">
                  </div>
                <% }) %>
              </div>
            <% } %> -->
          </div>
        </div>
      </div>

      <!-- Product Details -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fas fa-info-circle"></i>
            Product Information
          </h3>
        </div>
        <div class="card-body">
          <div class="detail-row">
            <div class="detail-label">
              <i class="fas fa-tag"></i>
              Name
            </div>
            <div class="detail-value"><strong><%= product.name %></strong></div>
          </div>

          <div class="detail-row">
            <div class="detail-label">
              <i class="fas fa-folder"></i>
              Category
            </div>
            <div class="detail-value"><%= product.categoryId ? product.categoryId.name : 'No Category' %></div>
          </div>

          <div class="detail-row">
            <div class="detail-label">
              <i class="fas fa-dollar-sign"></i>
              Price
            </div>
            <div class="detail-value price-value">₹<%= product.price %></div>
          </div>

          <div class="detail-row">
            <div class="detail-label">
              <i class="fas fa-barcode"></i>
              SKU
            </div>
            <div class="detail-value"><%= product.sku %></div>
          </div>

          <div class="detail-row">
            <div class="detail-label">
              <i class="fas fa-boxes"></i>
              Quantity
            </div>
            <div class="detail-value"><%= product.quantity %> units</div>
          </div>

          <div class="detail-row">
            <div class="detail-label">
              <i class="fas fa-cube"></i>
              Material
            </div>
            <div class="detail-value"><%= product.material %></div>
          </div>

          <div class="detail-row">
            <div class="detail-label">
              <i class="fas fa-palette"></i>
              Color
            </div>
            <div class="detail-value"><%= product.color %></div>
          </div>

          <div class="detail-row">
            <div class="detail-label">
              <i class="fas fa-toggle-on"></i>
              Status
            </div>
            <div class="detail-value">
              <span class="status-badge <%= product.status === 'active' ? 'status-active' : 'status-inactive' %>">
                <%= product.status %>
              </span>
            </div>
          </div>

          <div class="detail-row">
            <div class="detail-label">
              <i class="fas fa-align-left"></i>
              Description
            </div>
            <div class="detail-value"><%= product.description ? product.description : 'No description available' %></div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Image Zoom Modal -->
  <div id="zoomModal" class="zoom-modal" onclick="closeZoom(event)">
    <div class="zoom-modal-content">
      <img id="zoomImage" src="" alt="Zoomed Image" class="zoom-image">
      <button class="zoom-close" onclick="closeZoom(event)">
        <i class="fas fa-times"></i>
      </button>
      <% if (product.image.length > 1) { %>
        <button class="zoom-nav zoom-prev" onclick="previousImage(event)">
          <i class="fas fa-chevron-left"></i>
        </button>
        <button class="zoom-nav zoom-next" onclick="nextImage(event)">
          <i class="fas fa-chevron-right"></i>
        </button>
      <% } %>
    </div>
  </div>

  <script>
    const productImages =` <%= JSON.stringify(product.image) %>`;
    let currentImageIndex = 0;

    function changeMainImage(imageSrc, index) {
      document.getElementById('mainImage').src = imageSrc;
      currentImageIndex = index;
      
      // Update active thumbnail
      document.querySelectorAll('.thumbnail').forEach((thumb, i) => {
        if (i === index) {
          thumb.classList.add('active');
        } else {
          thumb.classList.remove('active');
        }
      });
    }

    function openZoom(index) {
      currentImageIndex = index;
      document.getElementById('zoomImage').src = productImages[currentImageIndex];
      document.getElementById('zoomModal').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeZoom(event) {
      if (event.target.id === 'zoomModal' || event.target.closest('.zoom-close')) {
        document.getElementById('zoomModal').classList.remove('active');
        document.body.style.overflow = 'auto';
      }
    }

    function previousImage(event) {
      event.stopPropagation();
      currentImageIndex = (currentImageIndex - 1 + productImages.length) % productImages.length;
      document.getElementById('zoomImage').src = productImages[currentImageIndex];
      changeMainImage(productImages[currentImageIndex], currentImageIndex);
    }

    function nextImage(event) {
      event.stopPropagation();
      currentImageIndex = (currentImageIndex + 1) % productImages.length;
      document.getElementById('zoomImage').src = productImages[currentImageIndex];
      changeMainImage(productImages[currentImageIndex], currentImageIndex);
    }

    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
      const modal = document.getElementById('zoomModal');
      if (modal.classList.contains('active')) {
        if (e.key === 'Escape') {
          modal.classList.remove('active');
          document.body.style.overflow = 'auto';
        } else if (e.key === 'ArrowLeft') {
          previousImage(e);
        } else if (e.key === 'ArrowRight') {
          nextImage(e);
        }
      }
    });
  </script>
</body>
</html>




































