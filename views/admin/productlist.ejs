<%- include("../../views/partials/admin/header") %>
<%- include("../../views/partials/admin/sidebar") %>


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css"/>
  <link href="/css/productlist.css" rel="stylesheet" type="text/css">
 
</head>
<body>
  <!-- Mobile Sidebar Toggle -->
  <button class="sidebar-toggle" onclick="toggleSidebar()">
    <i class="fas fa-bars"></i>
  </button>

  <!-- Sidebar Overlay -->
  <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <a href="/admin/dashboard" class="sidebar-brand">
        <i class="fas fa-shield-halved"></i>
        <span>Admin Panel</span>
      </a>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section-title">Main Navigation</div>
      <a href="/admin/dashboard" class="sidebar-link">
        <i class="fas fa-chart-line"></i>
        <span>Dashboard</span>
      </a>
      <a href="/admin/users" class="sidebar-link">
        <i class="fas fa-users"></i>
        <span>Customer Management</span>
      </a>
      <a href="/admin/category" class="sidebar-link">
        <i class="fas fa-folder"></i>
        <span>Category Management</span>
      </a>
      <a href="/admin/getproduct" class="sidebar-link active">
        <i class="fas fa-box"></i>
        <span>Products Management</span>
      </a>
      <a href="/admin/offers" class="sidebar-link">
        <i class="fas fa-tag"></i>
        <span>Offer Management</span>
      </a>
      <a href="/admin/orders" class="sidebar-link">
        <i class="fas fa-shopping-cart"></i>
        <span>Orders Management</span>
      </a>
      <a href="/admin/reports" class="sidebar-link">
        <i class="fas fa-file-chart"></i>
        <span>Reports</span>
      </a>
    </nav>
  </aside>

  <!-- Main Content Wrapper -->
  <div class="main-wrapper">
    <section class="content-main">
      <!-- Header -->
      <div class="content-header">
        <h2 class="content-title">Product Management</h2>
      </div>

      <!-- Header Actions: Search & Add Product -->
      <div class="header-actions">
        <form action="/admin/getproduct" method="GET" class="search-form">
          <input 
            type="text" 
            name="search" 
            value="<%= searchQuery %>" 
            placeholder="Search by Name or SKU..." 
            class="search-input"
          >
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-search"></i> Search
          </button>

         <% if (searchQuery && searchQuery.trim() !== '') { %>
      <a href="/admin/getproduct" class="btn btn-clear">
        <i class="fas fa-times"></i> Clear
      </a>
    <% } %>


        </form>
        <a href="/admin/addproduct" class="btn add-product-btn">
          Add Product
        </a>
      </div>

      <!-- Products Table -->
      <div class="card">
        <div class="card-body">
          <div class="table-container">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Product ID</th>
                  <th>Image</th>
                  <th>Name</th>
                  <th>Category</th>
                  <th>Price</th>
                  <th>Stock</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% products.forEach(product => { %>
                  <tr>
                    <td><strong>#<%= product.productId %></strong></td>
                    <td>
                      <% if (product.image && product.image.length > 0) { %>
                        <img src="<%= product.image[0] %>" class="product-image" alt="<%= product.name %>">
                      <% } else { %>
                        <div class="no-image">No Image</div>
                      <% } %>
                    </td>
                    <td><strong><%= product.name %></strong></td>
                    <td><%= product.categoryId ? product.categoryId.name : 'Uncategorized' %></td>
                    <td><strong>₹<%= product.price %></strong></td>
                    <td>
                      <% if (product.quantity > 0) { %>
                        <span class="stock-badge stock-in">
                          <i class="fas fa-check-circle"></i>
                          In Stock (<%= product.quantity %>)
                        </span>
                      <% } else { %>
                        <span class="stock-badge stock-out">
                          <i class="fas fa-times-circle"></i>
                          Out of Stock
                        </span>
                      <% } %>
                    </td>
                    <td>
                      <div class="action-buttons">
                        <a href="/admin/viewproduct/<%= product._id %>" class="btn btn-primary">
                          <i class="fas fa-eye"></i> View
                        </a>
                        <a href="/admin/editproduct/<%= product._id %>" class="btn btn-info">
                          <i class="fas fa-edit"></i> Edit
                        </a>
                        <button class="btn btn-danger delete-btn" data-id="<%= product._id %>">
                          <i class="fas fa-trash"></i> Delete
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Pagination -->
      <div class="pagination-container">
        <% if (currentPage > 1) { %>
          <a href="/admin/getproduct?page=<%= currentPage - 1 %>&search=<%= searchQuery %>" class="btn btn-light">
            <i class="fas fa-chevron-left"></i> Previous
          </a>
        <% } %>
        <span>Page <%= currentPage %> of <%= totalPages %></span>
        <% if (currentPage < totalPages) { %>
          <a href="/admin/getproduct?page=<%= currentPage + 1 %>&search=<%= searchQuery %>" class="btn btn-light">
            Next <i class="fas fa-chevron-right"></i>
          </a>
        <% } %>
      </div>
    </section>
  </div>

  <!-- Scripts -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    // Sidebar Toggle for Mobile
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.querySelector('.sidebar-overlay');
      sidebar.classList.toggle('active');
      overlay.classList.toggle('active');
    }

    // Delete Product with SweetAlert
    $(document).ready(function () {
      $(".delete-btn").click(function () {
        let productId = $(this).data("id");
        let row = $(this).closest("tr");

        Swal.fire({
          title: "Are you sure?",
          text: "This will delete the product (soft delete).",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#ef4444",
          cancelButtonColor: "#64748b",
          confirmButtonText: "Yes, delete it!",
          cancelButtonText: "Cancel"
        }).then((result) => {
          if (result.isConfirmed) {
            $.ajax({
              url: `/admin/deleteproduct/${productId}`,
              type: "DELETE",
              success: function (response) {
                Swal.fire({
                  title: "Deleted!",
                  text: response.message,
                  icon: "success",
                  timer: 1500,
                  showConfirmButton: false,
                  confirmButtonColor: "#10b981"
                }).then(() => {
                  row.fadeOut(400, function() {
                    $(this).remove();
                  });
                });
              },
              error: function (xhr) {
                Swal.fire({
                  title: "Error!",
                  text: xhr.responseText || "Something went wrong!",
                  icon: "error",
                  confirmButtonColor: "#ef4444"
                });
              }
            });
          }
        });
      });
    });
  </script>
</body>
</html>






























