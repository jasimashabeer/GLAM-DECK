


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Verification</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/forgotPassOtp.css">
</head>
<body>
    <header>
        <div class="logo-section">
            <img src="/images/1.png" alt=""> Glam Deck
        </div>
        <div>
            <!-----<a href="/admin/logout" style="color: white; text-decoration: none; font-weight: bold;">Logout</a>---->
        </div>
    </header>
    
    <div class="header-space"></div>
    
    <div class="page-wrapper">
        <div class="container">
        <div class="otp-card">
            <div class="heading-section">
                <div class="icon-wrapper">
                    <svg viewBox="0 0 24 24">
                        <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                </div>
                <h3>Email Verification</h3>
                <p class="subtitle">We've sent a verification code to your email. Please enter it below to continue.</p>
            </div>

            <div class="otp-timer-wrapper">
                <div class="otp-timer" id="otpTimer">1:00</div>
            </div>

            <form onsubmit="return validateOtpform()">
                <div class="form-group">
                    <label for="otp">Enter OTP Code</label>
                    <input type="text" id="otp" name="otp" class="form-control" placeholder="000000" maxlength="6" required>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Verify OTP</button>
                </div>
            </form>

            <div class="form-group">
                <button type="button" class="btn btn-link" onclick="resendOtp()">Resend OTP Code</button>
            </div>

            <%if (message && message.length>0){%>
                <div class="alert alert-danger">
                    <%=message %>
                </div>
            <% } %>

            <div class="footer-text">
                Already verified? <a href="/login">Login now</a>
            </div>
        </div>
    </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let otpTimerInterval;
        let timer = 60;

        function validateOtpform(){
            const otpInput = document.getElementById('otp').value;
            $.ajax({
                type: 'POST',
                url: '/verify-passForgot-otp',
                data: {otp: otpInput},
                success: function(response){
                    if(response.success){
                        Swal.fire({
                            icon: 'success',
                            title: 'OTP Verified Successfully',
                            showConfirmButton: false,
                            timer: 1500
                        })
                        .then(() => {
                            window.location.href = response.redirectUrl;
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Invalid OTP',
                            text: response.message
                        });
                    }
                },
                error: function(){
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to verify OTP. Please try again.'
                    });
                }
            });
            return false;
        }

        function updateTimerColor(percentage){
            const timerElement = document.getElementById('otpTimer');
            if(percentage > 50){
                timerElement.style.background = 'linear-gradient(135deg, #28a745 0%, #20c997 100%)';
                timerElement.style.boxShadow = '0 8px 20px rgba(40, 167, 69, 0.3)';
            } else if(percentage > 25){
                timerElement.style.background = 'linear-gradient(135deg, #ffc107 0%, #ff9800 100%)';
                timerElement.style.boxShadow = '0 8px 20px rgba(255, 193, 7, 0.3)';
            } else {
                timerElement.style.background = 'linear-gradient(135deg, #dc3545 0%, #c82333 100%)';
                timerElement.style.boxShadow = '0 8px 20px rgba(220, 53, 69, 0.3)';
            }
        }

        function startOtpTimer(){
            const timerElement = document.getElementById('otpTimer');
            otpTimerInterval = setInterval(function(){
                const minutes = Math.floor(timer / 60);
                const seconds = timer % 60;
                timerElement.textContent = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
                updateTimerColor((timer / 60) * 100);
                if(--timer < 0){
                    clearInterval(otpTimerInterval);
                    timerElement.textContent = 'Expired';
                    timerElement.style.background = 'linear-gradient(135deg, #dc3545 0%, #c82333 100%)';
                }
            }, 1000);
        }
        startOtpTimer();

        function resendOtp(){
            clearInterval(otpTimerInterval);
            timer = 60;
            startOtpTimer();
            $.ajax({
                type: 'POST',
                url: '/resend-forgot-otp',
                success: function(response){
                    if(response.success){
                        Swal.fire({
                            icon: 'success',
                            title: 'OTP Resent Successfully',
                            showConfirmButton: false,
                            timer: 1500
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Failed to resend OTP. Please try again.'
                        });
                    }
                }
            });
        }
    </script>
</body>
</html>



























