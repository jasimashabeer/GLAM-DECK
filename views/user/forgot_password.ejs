
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Forgot Password - Glam Deck</title>
  <link rel="icon" type="image/jpeg" href="images/favicon.jpg">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/forgotPassword.css">
 
</head>
<body>

  <!-- Header Space - Insert your header here -->
  <div class="header-placeholder">
    <!-- Your header content goes here -->
     <header style="background-color: #f44336; padding: 1rem; color: white; display: flex; justify-content: space-between; align-items: center;">
  <div style="font-size: 1.5rem; font-weight: bold; display: flex; align-items: center;">
  <img src="/images/1.png" alt=""> Glam Deck
  </div>
  <div>
  <!-----<a href="/admin/logout" style="color: white; text-decoration: none; font-weight: bold;">Logout</a>---->
  </div>
</header>

  </div>

  <div class="main-content">
    <div class="forgot-password-container">
      <div class="icon-wrapper">
        <svg viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
        </svg>
      </div>

      <h2>Forgot Password?</h2>
      <p class="subtitle">No worries! Enter your email address and we'll help you reset your password.</p>

      <form id="forgotForm" action="/forgot-email-valid" method="POST">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input 
            type="email" 
            name="email" 
            id="email" 
            placeholder="Enter your email address"
            autocomplete="email"
          />
          <span class="error" id="error"></span>
        </div>

        <button type="submit">Send Reset Link</button>
      </form>

      <div class="divider">OR</div>

      <a class="back-link" href="/login">← Back to Login</a>
    </div>
  </div>

  <script>
    const form = document.getElementById('forgotForm');
    const emailInput = document.getElementById('email');
    const errorDiv = document.getElementById('error');

    form.addEventListener('submit', function(e) {
      const email = emailInput.value.trim();
      const emailRegex = /^[^@]+@[^@]+\.[a-zA-Z]{2,}$/;

      if (!email) {
        e.preventDefault();
        errorDiv.textContent = 'Email is required.';
        return;
      }

      if (!emailRegex.test(email)) {
        e.preventDefault();
        errorDiv.textContent = 'Please enter a valid email address.';
        return;
      }

      errorDiv.textContent = '';
    });

    // Clear error on input
    emailInput.addEventListener('input', function() {
      errorDiv.textContent = '';
    });
  </script>
</body>
</html>
































