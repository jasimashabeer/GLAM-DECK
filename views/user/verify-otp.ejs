
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTP Verification</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> 
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding-top: 0;
            margin: 0;
        }

        /* Header */
        header {
            background-color: #f44336;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            padding: 1.2rem 2rem;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: #ffffff;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .header-links {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .header-links a {
            text-decoration: none;
            color: #ffffff;
            font-size: 0.95rem;
            font-weight: 500;
            transition: color 0.3s ease;
        }

        .header-links a:hover {
            color: #ffcdd2;
        }

        .header-btn {
            background: #204056;
            color: white;
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .header-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(32, 64, 86, 0.4);
        }

        /* Main Container */
        main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            padding: 3rem;
            width: 100%;
            max-width: 420px;
            animation: slideUp 0.5s ease;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .container h2 {
            font-size: 1.8rem;
            color: #333;
            margin-bottom: 0.5rem;
            text-align: center;
            font-weight: 600;
        }

        .container p {
            color: #666;
            text-align: center;
            margin-bottom: 2rem;
            font-size: 0.95rem;
            line-height: 1.5;
        }

        /* Form */
        #otpForm {
            margin-bottom: 1.5rem;
        }

        #otp {
            width: 100%;
            padding: 0.95rem 1rem;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 1.2rem;
            letter-spacing: 0.3rem;
            text-align: center;
            transition: all 0.3s ease;
            margin-bottom: 1.5rem;
            font-weight: 600;
        }

        #otp:focus {
            outline: none;
            border-color: #f44336;
            box-shadow: 0 0 0 3px rgba(244, 67, 54, 0.1);
        }

        .verify-btn {
            width: 100%;
            padding: 0.95rem;
            background: #204056;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(32, 64, 86, 0.3);
        }

        .verify-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(32, 64, 86, 0.4);
        }

        .verify-btn:active {
            transform: translateY(0);
        }

        /* Timer and Resend */
        .timer {
            text-align: center;
            color: #999;
            font-size: 0.9rem;
            margin-bottom: 1rem;
            min-height: 20px;
        }

        .resend-btn {
            width: 100%;
            padding: 0.85rem;
            background: #f5f5f5;
            color: #667eea;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .resend-btn:not(:disabled):hover {
            background: #f0f0f0;
            border-color: #667eea;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.2);
        }

        .resend-btn:disabled {
            cursor: not-allowed;
            background: #f5f5f5;
            color: #999;
            border-color: #e0e0e0;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 1.5rem;
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.85rem;
            margin-top: auto;
        }

        @media (max-width: 600px) {
            .container {
                padding: 2rem 1.5rem;
            }

            .header-content {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }

            .header-links {
                flex-direction: column;
                gap: 0.5rem;
            }

            .container h2 {
                font-size: 1.5rem;
            }
        }
    </style>
</head>





