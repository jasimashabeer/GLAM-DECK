<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Wishlist</title>
  <link rel="stylesheet" href="/css/wishlist.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <%- include("../../views/partials/user/header") %>
</head>
<body>

<div class="container wishlist-container">
  <h2 class="wishlist-title">Your Wishlist</h2>

  <% if (wishlist.length === 0) { %>
    <p class="text-center">Your wishlist is empty.</p>
  <% } else { %>
    <div class="row">
      <% wishlist.forEach(product => { %>
        <div class="col-md-4 d-flex">
          <div class="product-card w-100">
            <!-- <button class="remove-icon remove-from-wishlist" data-product-id="<%= product._id %>">&times;</button> -->
            <form action="/wishlist/remove/<%= product._id %>" method="POST">
              <button type="submit" class="remove-icon">&times;</button>
            </form>
            
          

            <a href="/productdetail/<%= product._id %>">
              <img src="<%= product.image[0] %>" alt="<%= product.name %>">
            </a>

            <div class="product-name"><%= product.name %></div>

            <div class="product-price">
              <% if (product.discountPrice < product.price) { %>
                <del>₹<%= product.price %></del>
                ₹<%= product.discountPrice %>
              <% } else { %>
                ₹<%= product.price %>
              <% } %>
            </div>

            <button class="add-to-cart-btn" data-product-id="<%= product._id %>">Add to Cart</button>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Working script -->
<script>
  console.log(" Test script running");

  document.addEventListener('DOMContentLoaded', () => {
    console.log(" JS loaded");

    document.querySelectorAll('.add-to-cart-btn').forEach(button => {
      button.addEventListener('click', async () => {
        const productId = button.getAttribute('data-product-id');

        try {
          const res = await fetch('/add-to-cart', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ productId, quantity: 1 })
          });

          const data = await res.json();

          if (res.ok) {
  Swal.fire('Success!', data.message, 'success');
} else {
  Swal.fire('Error', data.message || 'Something went wrong', 'error');
}

        } catch (err) { 
          console.error('❌ Error adding to cart:', err);
          alert('Error adding to cart');
        }
      });
    });
  });




  document.querySelectorAll('.remove-icon').forEach(button => {
      button.addEventListener('click', async (e) => {
        e.preventDefault(); // Prevent form submission

        // Show confirmation SweetAlert
        const result = await Swal.fire({
          title: 'Are you sure?',
          text: "You won't be able to undo this action!",
          icon: 'warning',
          showCancelButton: true,
          confirmButtonText: 'Yes, remove it!',
          cancelButtonText: 'Cancel',
        });

        if (result.isConfirmed) {
          // Send the request to remove the item from the wishlist
          const productId = button.closest('form').getAttribute('action').split('/').pop(); // Get product ID from form action URL

          try {
            const res = await fetch(`/wishlist/remove/${productId}`, {
              method: 'POST',
            });

            const data = await res.json();

            if (data.success) {
              // Show success SweetAlert
              Swal.fire(
                'Removed!',
                'The product has been removed from your wishlist.',
                'success'
              );

              // Optionally, remove the product from the page
              button.closest('.product-card').remove();
            } else {
              // Show error SweetAlert
              Swal.fire(
                'Error!',
                data.message || 'Something went wrong.',
                'error'
              );
            }
          } catch (err) {
            console.error('Error removing from wishlist:', err);
            Swal.fire(
              'Error!',
              'There was an issue removing the product.',
              'error'
            );
          }
        }
      });
    });
</script>

</body>
</html>
