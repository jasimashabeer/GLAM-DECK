<%- include('../partials/user/header') %>
<link rel="stylesheet" href="/style.css">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
    /* Custom styles for payment selection page */

/* General styling */
body {
  font-family: 'Poppins', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #F3F2EC;
  color: #333;
  padding: 20px 0;
  min-height: 100vh;
}

.container {
  max-width: 1140px;
}

/* Main container box styling */
.container.mt-5 {
  background-color: #F3F2EC;
  border-radius: 15px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  padding:0 20px;
  margin-bottom: 2rem;
}



.text-primary {
  color: #0d6efd !important;
}

.text-success {
  color: #198754 !important;
}

h3.mb-3.text-primary {
  position: relative;
  padding-bottom: 15px;
  margin-bottom: 20px;
  font-size: 1.75rem;
}

h3.mb-3.text-primary:after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 80px;
  height: 4px;
  background-color: #0d6efd;
  border-radius: 2px;
}

.text-dark strong {
  font-weight: 600;
  color: #343a40;
}

.text-muted {
  color: #6c757d !important;
  font-weight: 500;
}

.fw-semibold {
  font-weight: 600 !important;
  font-size: 1.1rem;
}

/* Payment option cards */
.card {
  border: none;
  transition: all 0.3s ease;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.07);
  height: 100%;
}

.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
}

.card-body {
  padding: 2rem 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  min-height: 220px;
  justify-content: space-between;
}

.card-title {
  font-weight: 600;
  margin-bottom: 0.5rem;
  font-size: 1.25rem;
  position: relative;
  padding-bottom: 15px;
}

.card-title:after {
  content: '';
  position: absolute;
  width: 50px;
  height: 3px;
  background-color: #0d6efd;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 2px;
}

.card-text {
  color: #6c757d;
  margin-bottom: 1.5rem;
  font-size: 0.95rem;
}

/* Payment method specific styling */
.col-md-4:nth-child(1) .card {
  border-top: 4px solid #0d6efd;
}

.col-md-4:nth-child(2) .card {
  border-top: 4px solid #ffc107;
}

.col-md-4:nth-child(3) .card {
  border-top: 4px solid #212529;
}

.col-md-4:nth-child(1) .card-title:after {
  background-color: #0d6efd;
}

.col-md-4:nth-child(2) .card-title:after {
  background-color: #ffc107;
}

.col-md-4:nth-child(3) .card-title:after {
  background-color: #212529;
}

/* Payment buttons styling */
.btn {
  font-weight: 500;
  padding: 0.7rem 1.8rem;
  border-radius: 50px;
  transition: all 0.3s ease;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-size: 0.9rem;
}

.btn-primary {
  background-color: #0d6efd;
  border-color: #0d6efd;
}

.btn-primary:hover {
  background-color: #0b5ed7;
  border-color: #0a58ca;
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(13, 110, 253, 0.2);
}

.btn-warning {
  background-color: #ffc107;
  border-color: #ffc107;
  color: #212529;
}

.btn-warning:hover {
  background-color: #ffca2c;
  border-color: #ffc720;
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(255, 193, 7, 0.2);
}

.btn-dark {
  background-color: #212529;
  border-color: #212529;
}

.btn-dark:hover {
  background-color: #424649;
  border-color: #373b3e;
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(33, 37, 41, 0.2);
}

.btn-secondary {
  background-color: #6c757d;
  border-color: #6c757d;
}

.btn-secondary:hover {
  background-color: #5c636a;
  border-color: #565e64;
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(108, 117, 125, 0.2);
}

/* Modal styling */
.modal-content {
  border-radius: 15px;
  border: none;
  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
  overflow: hidden;
}

/* Ensure wallet modal becomes visible when BS5 adds .show */
#walletPaymentModal.modal.show {
  display: block !important;
  opacity: 1 !important;
  visibility: visible !important;
}

#walletPaymentModal.modal.fade:not(.show) {
  opacity: 0 !important;
}

#walletPaymentModal .modal-dialog {
  transform: translate(0, 0) !important;
  opacity: 1 !important;
  visibility: visible !important;
}

#walletPaymentModal.modal.show .modal-dialog {
  transform: translate(0, 0) !important;
  opacity: 1 !important;
  visibility: visible !important;
}

/* Backdrop visibility */
.modal-backdrop.show {
  opacity: 0.5 !important;
  display: block !important;
}

.modal-header {
  background-color: #f0f7ff;
  border-bottom: 1px solid #dee2e6;
  padding: 1.5rem;
}

.modal-title {
  font-weight: 600;
  color: #0d6efd;
  display: flex;
  align-items: center;
  font-size: 1.25rem;
}

.modal-title::before {
  content: '💳';
  margin-right: 10px;
  font-size: 1.2rem;
}

.modal-body {
  padding: 2rem 1.5rem;
}

.modal-footer {
  border-top: 1px solid #dee2e6;
  background-color: #f8f9fa;
  padding: 1rem 1.5rem;
}

/* Wallet payment modal specifics */
#walletBalance, #payableAmount {
  font-weight: 600;
  color: #0d6efd;
}

.mb-3 h6 {
  background-color: #F3F2EC;
  padding: 12px 15px;
  border-radius: 8px;
  margin-bottom: 12px;
  border-left: 3px solid #0d6efd;
  font-size: 0.95rem;
}

#insufficientFunds .alert {
  border-radius: 8px;
  padding: 1rem 1.25rem;
  border-left: 4px solid #ffc107;
  background-color: #F3F2EC;
  color: #856404;
}

#insufficientFunds .btn {
  margin-top: 10px;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .card {
    margin-bottom: 1.5rem;
  }
  
  .btn {
    width: 100%;
  }
  
  .container.mt-5 {
    padding: 1.5rem;
    margin-top: 1rem !important;
  }
  
  h3.mb-3.text-primary {
    font-size: 1.5rem;
  }
  
  .retry-payment-box {
    padding: 15px;
  }
}

/* Add payment method icons */
.card-title {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-title:before {
  font-size: 2rem;
  margin-bottom: 15px;
}

.col-md-4:nth-child(1) .card-title:before {
  content: '👛';
}

.col-md-4:nth-child(2) .card-title:before {
  content: '💵';
}

.col-md-4:nth-child(3) .card-title:before {
  content: '💳';
}
 @import url('https://fonts.googleapis.com/css2?family=Pacifico&display=swap');

  .welcome-text {
    font-family:'Times New Roman', Times, serif;
    font-size: 1.5rem;
    animation: colorChange 3s infinite alternate;
    text-align:left;
    margin-top: 20px;
  }

  @keyframes colorChange {
    0%   { color: #007bff; }   /* Bootstrap blue */
    25%  { color: #6610f2; }   /* Indigo */
    50%  { color: #e83e8c; }   /* Pink */
    75%  { color: #20c997; }   /* Teal */
    100% { color: #198754; }   /* Bootstrap green */
  }
</style>

  <div class="container mt-5">
  <a href="/orders" class="btn btn-primary" style="margin-left: 850px;" >Back to Orders</a>
    <div class="container mt-5">

        <h3 class="mb-3 text-primary fw-bold">Choose a Retry Payment Method</h3>

        <div class="row">
          <div class="col-md-6 mb-2">
            <h5 class="text-dark">
              <strong>Order ID:</strong>
              <span class="text-muted"><%= order.orderId %></span>
            </h5>
          </div>
          <div class="col-md-6 mb-2">
            <h5 class="text-dark">
              <strong>Amount Payable:</strong>
              <span class="text-success fw-semibold"
                >₹<%= order.finalAmount.toFixed(2) %></span
              >
            </h5>
          </div>
        </div>

    </div>

    <div class="row">
      <!-- Wallet Payment Option -->
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <div class="card-body text-center">
            <h5 class="card-title">Wallet</h5>
            <p class="card-text">Pay using your wallet balance.</p>
            <button
              class="btn btn-primary"
              data-bs-toggle="modal"
              data-bs-target="#walletPaymentModal"
            >
              Pay with Wallet
            </button>
          </div>
        </div>
      </div>

      <!-- Cash on Delivery Option -->
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <div class="card-body text-center">
            <h5 class="card-title">Cash on Delivery</h5>
            <p class="card-text">Pay in cash upon delivery.</p>
            <button
              class="btn btn-warning"
              id="codPaymentBtn"
              data-order-id="<%= order._id %>"
            >
              Place Order
            </button>
          </div>
        </div>
      </div>

      <!-- Razorpay Option -->
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <div class="card-body text-center">
            <h5 class="card-title">Razorpay</h5>
            <p class="card-text">Pay securely using Razorpay.</p>
            <button
              type="button"
              class="btn btn-dark"
              id="razorpayPaymentBtn"
              data-order-id="<%= order._id %>"
            >
              Pay with Razorpay
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Wallet Payment Modal -->
  <div
    class="modal fade"
    id="walletPaymentModal"
    tabindex="-1"
    aria-labelledby="walletPaymentModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="walletPaymentModalLabel">
            Wallet Payment
          </h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <h6>
              Available Balance: ₹<span id="walletBalance"
                ><%=user.wallet.balance%></span
              >
            </h6>
            <h6>
              Payable Amount: ₹<span id="payableAmount"
                ><%=order.finalAmount%></span
              >
            </h6>
          </div>
          <div id="insufficientFunds" style="display: none">
            <div class="alert alert-warning">
              Insufficient funds in wallet. Please add money to continue.
            </div>
            <a href="/wallet" class="btn btn-primary"> Add Money </a>
          </div>
        </div>
        <div class="modal-footer">
          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal"
          >
            Close
          </button>

          <button
            type="button"
            class="btn btn-primary"
            id="confirmWalletPayment"
            data-order-id="<%= order._id %>"
          >
            Pay Now
          </button>
        </div>
      </div>
    </div>
  </div>
<!-- Bootstrap 5 JS Bundle (includes Popper) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  // ✅ Wallet modal initialization and visibility fix
  document.addEventListener('DOMContentLoaded', function() {
    const modalEl = document.getElementById("walletPaymentModal");
    const triggerBtn = document.querySelector('[data-bs-target="#walletPaymentModal"]');
    
    if (modalEl && triggerBtn) {
      // Handle button click to ensure modal opens properly
      triggerBtn.addEventListener('click', function(e) {
        e.preventDefault();
        try {
          let modal = bootstrap.Modal.getInstance(modalEl);
          if (!modal) {
            modal = new bootstrap.Modal(modalEl, { backdrop: true, keyboard: true });
          }
          modal.show();
          
          // Ensure modal is visible after showing
          setTimeout(() => {
            modalEl.classList.add('show');
            modalEl.style.display = 'block';
            modalEl.style.opacity = '1';
            modalEl.style.visibility = 'visible';
          }, 10);
        } catch (err) {
          console.error('Error showing wallet modal:', err);
        }
      });
    }

    // Ensure modal is visible when shown
    if (modalEl) {
      modalEl.addEventListener("show.bs.modal", () => {
        setTimeout(() => {
          modalEl.classList.add('show');
          modalEl.style.display = 'block';
          modalEl.style.opacity = '1';
          modalEl.style.visibility = 'visible';
        }, 10);
      });

      modalEl.addEventListener("shown.bs.modal", () => {
        const balance = parseFloat(document.getElementById("walletBalance").textContent);
        const payable = parseFloat(document.getElementById("payableAmount").textContent);
        const insufficient = document.getElementById("insufficientFunds");
        const confirmBtn = document.getElementById("confirmWalletPayment");

        // Ensure modal is still visible
        modalEl.classList.add('show');
        modalEl.style.display = 'block';
        modalEl.style.opacity = '1';
        modalEl.style.visibility = 'visible';

        if (balance < payable) {
          insufficient.style.display = "block";
          confirmBtn.disabled = true;
        } else {
          insufficient.style.display = "none";
          confirmBtn.disabled = false;
        }
      });
    }
  });

  // ✅ COD Payment Retry
  document.getElementById("codPaymentBtn").addEventListener("click", async function () {
    const orderId = this.dataset.orderId;

    try {
      const res = await fetch(`/retry-payment/cod/${orderId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
      });

      const data = await res.json();

      if (res.ok && data.status) {
        Swal.fire({
          icon: "success",
          title: "Payment Successful",
          text: "Payment switched to COD successfully.",
          timer: 2000,
          showConfirmButton: false
        }).then(() => {
          window.location.href = `/order-success?orderId=${data.orderId}`;
        });
      } else {
        Swal.fire({
          icon: "error",
          title: "COD Failed",
          text: data.message || "Unable to switch to COD.",
        });
      }
    } catch (err) {
      console.error(err);
      Swal.fire("Network Error", "Please check your connection and try again.", "error");
    }
  });

  // ✅ Wallet Payment Retry
  document.getElementById("confirmWalletPayment").addEventListener("click", async function () {
    const orderId = this.dataset.orderId;

    try {
      const res = await fetch(`/retry-payment/wallet/${orderId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
      });

      const data = await res.json();

      if (res.ok && data.status) {
        Swal.fire({
          icon: "success",
          title: "Wallet Payment Successful",
          text: "Wallet payment completed successfully!",
          timer: 2000,
          showConfirmButton: false
        }).then(() => {
          window.location.href = `/order-success?orderId=${data.orderId}`;
        });
      } else {
        Swal.fire("Payment Failed", data.message || "Unable to process wallet payment.", "error");
      }
    } catch (err) {
      console.error(err);
      Swal.fire("Network Error", "Please check your connection and try again.", "error");
    }
  });

  //  Razorpay Retry
  document.getElementById("razorpayPaymentBtn").addEventListener("click", async function () {
    const orderId = this.dataset.orderId;

    try {
      const response = await fetch('/retry-payment/razorpay', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId })
      });

      const orderData = await response.json();

      if (!response.ok) {
        const errorMsg = orderData.message || orderData.error || 'Failed to create Razorpay order';
        console.error('Server error:', errorMsg, orderData);
        Swal.fire("Error", errorMsg, "error");
        return;
      }

      if (!orderData.id || !orderData.amount) {
        console.error('Missing required fields in response:', orderData);
        Swal.fire("Error", "Invalid response from server. Please try again.", "error");
        return;
      }
      
      // Ensure we have the correct orderId - use orderData.orderId (from controller response)
      const mongoOrderId = orderData.orderId || orderId;
      
      // Ensure amount is correct - it should be in paisa (already multiplied by 100 in controller)
      const amount = orderData.amount;

      // Use a variable in outer scope to track payment status
      let paymentCompleted = false;
      let redirecting = false;

      const redirectToSuccess = () => {
        if (!redirecting) {
          redirecting = true;
          window.location.href = `/order-success?orderId=${mongoOrderId}`;
        }
      };

      const redirectToFailure = () => {
        if (!paymentCompleted && !redirecting) {
          redirecting = true;
          window.location.href = `/payment-failure?orderId=${mongoOrderId}`;
        }
      };

      const options = {
        key: "<%= process.env.RAZORPAY_KEY_ID %>",
        amount: amount,
        currency: "INR",
        name: "Glam Deck",
        description: "Retry Payment",
        order_id: orderData.id,
        handler: async function (response) {
          if (paymentCompleted || redirecting) return;
          
          try {
            const verifyRes = await fetch("/retry-payment/verify", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                razorpay_order_id: response.razorpay_order_id,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_signature: response.razorpay_signature,
                orderId: mongoOrderId
              }),
            });

            if (!verifyRes.ok) {
              throw new Error('Verification failed');
            }

            const verifyData = await verifyRes.json();
            if (verifyData.success) {
              paymentCompleted = true;
              Swal.fire({
                title: "Success!",
                text: "Razorpay Payment Successful!",
                icon: "success",
                timer: 1500,
                showConfirmButton: false
              }).then(() => {
                redirectToSuccess();
              });
            } else {
              redirectToFailure();
            }
          } catch (err) {
            console.error('Verification error:', err);
            redirectToFailure();
          }
        },
        prefill: {
          email: "<%= user.email %>",
          contact: "<%= user.phone %>",
        },
        theme: { color: "#0d6efd" },
        modal: {
          ondismiss: function () {
            setTimeout(() => {
              redirectToFailure();
            }, 100);
          }
        }
      };

      const paymentObject = new Razorpay(options);

      paymentObject.on("payment.failed", function (response) {
        console.log('Payment failed:', response);
        redirectToFailure();
      });

      paymentObject.open();
    } catch (err) {
      console.error('Razorpay retry error:', err);
      const errorMessage = err.message || "An error occurred. Please try again.";
      Swal.fire("Error", errorMessage, "error");
    }
  });


</script>