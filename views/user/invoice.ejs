<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Invoice - <%= order.orderId %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body { 
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
      color: #333;
      padding: 2rem 0;
      min-height: 100vh;
    }

    .page-wrapper {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .invoice-container { 
      background: white;
      border-radius: 16px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
      padding: 3rem;
      margin-bottom: 2rem;
    }

    /* Header Section */
    .invoice-header { 
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 2rem;
      margin-bottom: 2rem;
      border-bottom: 3px solid #667eea;
      position: relative;
    }

    .invoice-header::after {
      content: '';
      position: absolute;
      bottom: -3px;
      left: 0;
      width: 200px;
      height: 3px;
      background: linear-gradient(90deg, #667eea, #764ba2);
    }

    .invoice-branding {
      flex: 1;
    }

    .invoice-title { 
      font-size: 2.5rem;
      font-weight: 700;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 1rem;
      letter-spacing: 1px;
    }

    .invoice-meta {
      color: #666;
      font-size: 0.95rem;
      line-height: 1.8;
    }

    .invoice-meta strong {
      color: #333;
      font-weight: 600;
    }

    .company-details { 
      text-align: right;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 1.5rem;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }

    .company-details strong {
      font-size: 1.3rem;
      display: block;
      margin-bottom: 0.75rem;
      letter-spacing: 0.5px;
    }

    .company-details div {
      font-size: 0.9rem;
      line-height: 1.6;
      opacity: 0.95;
    }

    /* Invoice Details Section */
    .invoice-details {
      margin-bottom: 2.5rem;
    }

    .invoice-details-row { 
      display: flex;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 2rem;
    }

    .detail-box {
      flex: 1;
      background: #f8f9fa;
      padding: 1.5rem;
      border-radius: 10px;
      border-left: 4px solid #667eea;
    }

    .section-title { 
      font-size: 1rem;
      font-weight: 700;
      color: #667eea;
      margin-bottom: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .detail-box p {
      margin-bottom: 0.4rem;
      color: #555;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .detail-box strong {
      color: #333;
      font-weight: 600;
    }

    /* Status and Payment Info */
    .info-row {
      display: flex;
      gap: 2rem;
      margin-bottom: 2.5rem;
    }

    .info-box {
      flex: 1;
      background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
      padding: 1.25rem;
      border-radius: 10px;
      text-align: center;
      border: 2px solid #e0e0e0;
    }

    .info-box .section-title {
      margin-bottom: 0.75rem;
      font-size: 0.85rem;
    }

    .info-content {
      font-size: 1.1rem;
      font-weight: 600;
      color: #333;
    }

    .badge {
      padding: 0.5rem 1.25rem;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .bg-success { background-color: #28a745 !important; }
    .bg-danger { background-color: #dc3545 !important; }
    .bg-info { background-color: #17a2b8 !important; }
    .bg-warning { background-color: #ffc107 !important; }
    .bg-secondary { background-color: #6c757d !important; }

    /* Table Section */
    .items-section-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: #333;
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 2px solid #e0e0e0;
    }

    table { 
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin-bottom: 2rem;
      overflow: hidden;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    thead {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }

    th { 
      padding: 1rem;
      font-weight: 600;
      text-align: left;
      text-transform: uppercase;
      font-size: 0.85rem;
      letter-spacing: 0.5px;
    }

    th:first-child {
      border-top-left-radius: 10px;
    }

    th:last-child {
      border-top-right-radius: 10px;
      text-align: right;
    }

    tbody tr {
      background: white;
      transition: all 0.3s ease;
    }

    tbody tr:hover {
      background: #f8f9fa;
      transform: scale(1.01);
    }

    tbody tr:last-child td:first-child {
      border-bottom-left-radius: 10px;
    }

    tbody tr:last-child td:last-child {
      border-bottom-right-radius: 10px;
    }

    td { 
      padding: 1rem;
      border-bottom: 1px solid #e9ecef;
      color: #555;
      font-size: 0.9rem;
    }

    td:last-child {
      text-align: right;
      font-weight: 600;
      color: #333;
    }

    .product-image { 
      width: 70px;
      height: 70px;
      object-fit: cover;
      border-radius: 8px;
      border: 2px solid #e0e0e0;
      transition: transform 0.3s ease;
    }

    .product-image:hover {
      transform: scale(1.1);
    }

    /* Total Section */
    .total-section { 
      background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
      padding: 2rem;
      border-radius: 12px;
      margin-top: 2rem;
      border: 2px solid #e0e0e0;
    }

    .total-row { 
      display: flex;
      justify-content: flex-end;
      align-items: center;
      margin-bottom: 1rem;
      padding: 0.5rem 0;
    }

    .total-label { 
      width: 180px;
      text-align: right;
      margin-right: 2rem;
      font-weight: 500;
      color: #555;
      font-size: 1rem;
    }

    .total-value { 
      width: 120px;
      text-align: right;
      font-weight: 600;
      color: #333;
      font-size: 1rem;
    }

    .grand-total { 
      font-weight: 700;
      font-size: 1.3rem;
      border-top: 3px solid #667eea;
      padding-top: 1rem;
      margin-top: 0.5rem;
    }

    .grand-total .total-label,
    .grand-total .total-value {
      color: #667eea;
      font-size: 1.3rem;
    }

    /* Footer */
    .footer { 
      text-align: center;
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 2px solid #e0e0e0;
      color: #666;
    }

    .footer p {
      margin-bottom: 0.5rem;
      font-size: 0.95rem;
    }

    .footer p:first-child {
      font-weight: 600;
      color: #333;
      font-size: 1.1rem;
    }

    /* Action Buttons */
    .action-buttons {
      text-align: center;
      margin-top: 2rem;
    }

    .btn-custom {
      padding: 0.85rem 2rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.3s ease;
      border: none;
      margin: 0 0.5rem;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
    }

    .btn-back {
      background: white;
      color: #667eea;
      border: 2px solid #667eea;
    }

    .btn-back:hover {
      background: #667eea;
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

    .btn-download {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .btn-download:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .invoice-container {
        padding: 2rem 1.5rem;
      }

      .invoice-header {
        flex-direction: column;
        gap: 1.5rem;
      }

      .company-details {
        text-align: left;
      }

      .invoice-details-row {
        flex-direction: column;
        gap: 1rem;
      }

      .info-row {
        flex-direction: column;
        gap: 1rem;
      }

      table {
        font-size: 0.85rem;
      }

      th, td {
        padding: 0.75rem 0.5rem;
      }

      .product-image {
        width: 50px;
        height: 50px;
      }

      .total-label {
        width: 140px;
        margin-right: 1rem;
        font-size: 0.9rem;
      }

      .total-value {
        width: 100px;
        font-size: 0.9rem;
      }

      .grand-total .total-label,
      .grand-total .total-value {
        font-size: 1.1rem;
      }

      .btn-custom {
        display: block;
        width: 100%;
        margin: 0.5rem 0;
      }
    }

    /* Print Styles */
    @media print {
      body {
        background: white;
        padding: 0;
      }

      .invoice-container {
        box-shadow: none;
        padding: 1rem;
      }

      .action-buttons {
        display: none;
      }

      .page-wrapper {
        padding: 0;
      }
    }
  </style>
</head>
<body>

  <div class="page-wrapper">
    <div class="invoice-container" id="invoice">
      <!-- Header -->
      <div class="invoice-header">
        <div class="invoice-branding">
          <div class="invoice-title">INVOICE</div>
          <div class="invoice-meta">
            <div><strong>Invoice No:</strong> <%= order.orderId %></div>
            <div><strong>Date:</strong> <%= new Date(order.createdOn).toLocaleDateString() %></div>
          </div>
        </div>
        <div class="company-details">
          <strong>Glam Deck</strong>
          <div>Ann Syra Complex</div>
          <div>Kerala, Palakkad</div>
          <div>Phone: 9999999999</div>
          <div>Email: glamdeck@gmail.com</div>
        </div>
      </div>

      <!-- Address Details -->
      <div class="invoice-details">
        <div class="invoice-details-row">
          <div class="detail-box">
            <div class="section-title">Bill To</div>
            <% if (selectedAddress) { %>
              <p><strong><%= selectedAddress.name %></strong> - <%= selectedAddress.addressType %></p>
              <p><%= selectedAddress.locality %>, <%= selectedAddress.city %></p>
              <p><%= selectedAddress.state %></p>
              <p>Pin: <%= selectedAddress.pincode %></p>
              <p>Ph: <%= selectedAddress.mobile %></p>
              <p><%= user.email %></p>
            <% } else { %>
              <p class="text-danger">Address not found.</p>
            <% } %>
          </div>

          <div class="detail-box">
            <div class="section-title">Ship To</div>
            <% if (selectedAddress) { %>
              <p><strong><%= selectedAddress.name %></strong> - <%= selectedAddress.addressType %></p>
              <p><%= selectedAddress.locality %>, <%= selectedAddress.city %></p>
              <p><%= selectedAddress.state %></p>
              <p>Pin: <%= selectedAddress.pincode %></p>
              <p>Ph: <%= selectedAddress.mobile %></p>
              <p><%= user.email %></p>
            <% } else { %>
              <p class="text-danger">Address not found.</p>
            <% } %>
          </div>
        </div>

        <!-- Payment and Status Info -->
        <div class="info-row">
          <div class="info-box">
            <div class="section-title">Payment Method</div>
            <div class="info-content"><%= order.paymentMethod || 'Cash On Delivery' %></div>
          </div>
          <div class="info-box">
            <div class="section-title">Order Status</div>
            <div class="info-content">
              <span class="badge 
                <%= order.status === 'delivered' ? 'bg-success' : 
                    order.status === 'cancelled' ? 'bg-danger' :
                    order.status === 'shipped' ? 'bg-info text-dark' : 
                    order.status === 'returned' ? 'bg-secondary' : 
                    'bg-warning text-dark' %>">
                <%= order.status.toUpperCase() %>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Order Items -->
      <div class="items-section-title">Order Items</div>
      <table>
        <thead>
          <tr>
            <th>Image</th>
            <th>Product</th>
            <th>Qty</th>
            <th>Price</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <% order.orderedItems.forEach(item => { %>
            <tr>
              <td><img src="/uploads/images/<%= item.product.image[0] %>" alt="Product" class="product-image"></td>
              <td><strong><%= item.product.productName %></strong></td>
              <td><%= item.quantity %></td>
              <td>₹<%= item.product.salePrice %></td>
              <td>₹<%= item.price %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <!-- Total Section -->
      <div class="total-section">
        <div class="total-row">
          <div class="total-label">Subtotal:</div>
          <div class="total-value">₹<%= order.totalPrice %></div>
        </div>
        <div class="total-row">
          <div class="total-label">Discount:</div>
          <div class="total-value">- ₹<%= order.discount || 0 %></div>
        </div>
        <div class="total-row">
          <div class="total-label">Delivery Charge:</div>
          <div class="total-value">₹<%= shippingCharge || 0 %></div>
        </div>
        <div class="total-row grand-total">
          <div class="total-label">Grand Total:</div>
          <div class="total-value">₹<%= order.finalAmount %></div>
        </div>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>Thank you for shopping with Glam Deck!</p>
        <p>For support, contact: support@glamdeck.com | Phone: 9999999999</p>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="action-buttons">
      <a href="/userProfile" class="btn-custom btn-back">← Go Back</a>
      <button onclick="downloadPDF()" class="btn-custom btn-download">⬇ Download Invoice</button>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <script>
    function downloadPDF() {
      const element = document.getElementById('invoice');
      const opt = {
        margin: 0.5,
        filename: 'invoice_<%= order.orderId %>.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2 },
        jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
      };
      html2pdf().set(opt).from(element).save();
    }
  </script>

</body>
</html>
