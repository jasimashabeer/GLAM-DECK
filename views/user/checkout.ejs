<%- include("../partials/user/header") %>

  <!-- Bootstrap 5 CSS for modal -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- Minimal overrides so Bootstrap 5 modal works alongside Bootstrap 3 CSS -->
  <style>
    /* Ensure coupon modal becomes visible when BS5 adds .show */
    #couponModal.modal.show {
      display: block !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    #couponModal.modal.fade:not(.show) {
      opacity: 0 !important;
    }

    /* Prevent BS3 transform slide conflict */
    #couponModal.modal.fade .modal-dialog {
      transform: none !important;
    }

    #couponModal.modal.show .modal-dialog {
      transform: translate(0, 0) !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    /* Ensure wallet modal becomes visible when BS5 adds .show */
    #walletPaymentModal.modal.show {
      display: block !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    #walletPaymentModal.modal.fade:not(.show) {
      opacity: 0 !important;
    }

    #walletPaymentModal .modal-dialog {
      transform: translate(0, 0) !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    #walletPaymentModal.modal.show .modal-dialog {
      transform: translate(0, 0) !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    /* Prevent BS3 transform slide conflict */
    #couponModal.modal.fade .modal-dialog {
      transform: none !important;
    }

    /* Backdrop visibility */
    .modal-backdrop.show {
      opacity: 0.5 !important;
      display: block !important;
    }
  </style>

  <section class="py-5 bg-light">
    <div class="container">
      <div class="row">

        <!-- Shipping Address -->
        <div class="col-md-7 mb-4">
          <div class="card shadow-sm">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 fw-bold">Shipping Address</h5>
                <a href="/address" class="btn btn-primary btn-sm">Add New Address</a>
              </div>

              <% userAddresses.forEach((address, index)=> { %>
                <div class="form-check mb-3">
                  <input class="form-check-input" type="radio" name="selectedAddress" id="address<%= index %>"
                    value="<%= address._id %>" <%=address.isDefault ? 'checked' : '' %>>
                  <label class="form-check-label" for="address<%= index %>">
                    <div class="p-2 bg-white border rounded">
                      <p class="mb-1"><strong>
                          <%= address.name %>
                        </strong>
                        <%= address.addressType %>
                      </p>
                      <p class="mb-1">
                        <%= address.locality %>, <%= address.city %>
                      </p>
                      <p class="mb-1">
                        <%= address.state %>
                      </p>
                      <p class="mb-1">Pin: <%= address.pincode %>
                      </p>
                      <p class="mb-1"><small>Ph: <%= address.mobile %></small></p>
                    </div>
                  </label>
                </div>
                <% }) %>

            </div>
          </div>
        </div>

        <!-- Order Summary -->
        <div class="col-md-5">
          <div class="card shadow-sm">
            <div class="card-body">
              <h5 class="fw-bold mb-3">Your Order</h5>

              <ul class="list-group mb-3">
                <% cartItems.forEach(item=> { %>
                  <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                    <div class="d-flex align-items-center">
                      <img src="/uploads/images/<%= item.product.image?.[0] || 'default.jpg' %>" alt="product"
                        width="50" height="50" class="me-2 rounded">
                      <div>
                        <strong>
                          <%= item.product.productName %>
                        </strong><br>
                        <small class="text-muted">Qty: <%= item.quantity %></small>
                      </div>
                    </div>
                    <span>₹<%= item.totalPrice %></span>
                  </li>
                  <% }) %>
              </ul>
              <% if (quantityAdjusted) { %>
                <div class="alert d-flex align-items-center justify-content-center" role="alert"
                  style="background-color: #fff3cd; border-color: #ff8c00; color: #856404;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-2"
                    viewBox="0 0 16 16">
                    <path
                      d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                  </svg>
                  <span><strong>Inventory Update:</strong> Cart quantities have been adjusted to reflect current stock
                    availability.</span>
                </div>
                <% } %>


                  <!-- Apply Coupon -->
                  <div id="couponFormSection" style="<%= appliedCoupon ? 'display: none;' : '' %>">
                    <h6 class="fw-bold">Apply Coupon</h6>
                    <form id="couponForm" class="input-group mb-3">
                      <input type="text" class="form-control" name="couponCode" id="couponCodeInput"
                        placeholder="Enter coupon code" style="height: 50px; margin-top: 15px;">
                      <button class="btn btn-primary" type="submit" style="height: 50px;">Apply</button>
                    </form>
                    <div id="couponError" class="text-danger small mb-2"></div>
                    <div id="couponSuccess" class="text-success small mb-2"></div>
                    <a href="#" class="text-decoration-none small" data-bs-toggle="modal"
                      data-bs-target="#couponModal">View Coupons</a>
                  </div>

                  <!-- Coupon Modal -->
                  <div class="modal fade" id="couponModal" tabindex="-1" aria-labelledby="couponModalLabel"
                    aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content shadow-sm">
                        <div class="modal-header">
                          <h5 class="modal-title fw-bold" id="couponModalLabel">Select a Coupon</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                          <% if (coupons.length> 0) { %>
                            <% coupons.forEach((coupon, i)=> { %>
                              <div class="form-check mb-3 border rounded px-3 py-2">
                                <input class="form-check-input" type="radio" name="selectedCoupon" id="coupon<%= i %>"
                                  value="<%= coupon.couponName %>">
                                <label class="form-check-label w-100" for="coupon<%= i %>">
                                  <div>
                                    <span class="fw-bold text-primary">
                                      <%= coupon.couponName %>
                                    </span><br>
                                    <span class="text-success fw-semibold">₹<%= coupon.offerPrice %> Off</span>
                                    <span class="text-muted small"> on orders above ₹<%= coupon.minimumPrice %>
                                        </span><br>
                                    <small class="text-warning">Expires on <%= coupon.endDate.toDateString() %></small>
                                  </div>
                                </label>
                              </div>
                              <% }) %>
                                <% } else { %>
                                  <div class="text-center text-muted py-3">
                                    <i class="bi bi-ticket-perforated fs-3 d-block mb-2"></i>
                                    <strong>No coupons available</strong>
                                  </div>
                                  <% } %>
                        </div>

                        <div class="modal-footer">
                          <button class="btn btn-secondary" data-bs-dismiss="modal">Clear Selection</button>
                          <button class="btn btn-primary" id="applyCouponFromModal">Proceed</button>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Applied Coupon -->
                  <div id="appliedCouponSection" style="<%= appliedCoupon ? '' : 'display: none;' %>">
                    <p class="mb-1">Applied Coupon: <span id="appliedCouponName" class="fw-bold">
                        <%= appliedCoupon %>
                      </span></p>
                    <button type="button" class="btn btn-danger btn-sm" id="removeCouponBtn"
                      style="height: 30px;">Remove Coupon</button>
                  </div>

                  <hr class="my-2">

                  <div class="d-flex justify-content-between mb-1">
                    <span>Subtotal</span>
                    <strong>₹<%= subtotal %></strong>
                  </div>
                  <div class="d-flex justify-content-between mb-1">
                    <span>Coupon Discount</span>
                    <strong class="text-success">(-) ₹<span id="discountAmount">
                        <%= discount %>
                      </span></strong>
                  </div>
                  <div class="d-flex justify-content-between mb-1">
                    <span>Shipping</span>
                    <strong>₹<%= shippingCharge %></strong>
                  </div>
                  <div class="mb-2">
                    <a href="/shipping-details" class="text-decoration-none small">View shipping charge</a>
                  </div>

                  <hr class="my-2">

                  <div class="d-flex justify-content-between mb-3">
                    <span>Total</span>
                    <strong id="grandTotal">₹<%= finalTotal %></strong>
                  </div>

                  <hr class="my-3">

                  <!-- Payment Method -->
                  <h6 class="fw-bold mb-2">Payment Method</h6>
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="paymentMethod" id="razorpay" value="Razorpay">
                    <label class="form-check-label" for="razorpay">Online Payment</label>
                  </div>

                  <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="paymentMethod" id="paymentWallet" value="Wallet">
                    <label class="form-check-label" for="wallet">Wallet Payment (Balance: ₹<%=user.wallet.balance %>
                        )</label>
                  </div>

                  <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" name="paymentMethod" id="cod" value="Cash On Delivery"
                      checked>
                    <label class="form-check-label" for="cod">Cash on Delivery</label>
                  </div>


                  <button class="btn btn-warning w-100" onclick="placeOrder()">Place Order</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="modal fade" id="walletPaymentModal" tabindex="-1" aria-labelledby="walletPaymentModalLabel"
    aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="walletPaymentModalLabel">
            Wallet Payment
          </h5>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <h6>
              Available Balance: ₹<span id="walletBalance">
                <%= user.wallet.balance.toFixed(2) %>
              </span>
            </h6>
            <h6>Payable Amount: ₹<span id="payableAmount"></span></h6>
          </div>
          <div id="insufficientFunds" style="display: none">
            <div class="alert alert-warning">
              Insufficient funds in wallet. Please add money to continue.
            </div>
            <a href="/wallet#add-money-button" class="btn btn-primary">Add Money</a>
          </div>
        </div>
        <div class="modal-footer">


          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Close
          </button>

          <button type="button" class="btn btn-primary" id="confirmWalletPayment">
            Pay Now
          </button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-Gn5384xqQ1aoWXA+058RXPXfg6Nv6JCzF5ZC8EG5fAwIQ9k/rwZV+YFf5Xq5drFQ"
    crossorigin="anonymous"></script>

  <script>
    // Utility function to clean up stuck backdrops and restore page interaction
    function cleanupModalBackdrop() {
      const backdrops = document.querySelectorAll('.modal-backdrop');
      backdrops.forEach(backdrop => backdrop.remove());
      document.body.classList.remove('modal-open');
      document.body.style.overflow = '';
      document.body.style.paddingRight = '';
    }

    // Ensure coupon modal opens and backdrops are cleaned even with mixed Bootstrap versions
    document.addEventListener('DOMContentLoaded', function () {
      const couponModalEl = document.getElementById('couponModal');
      const trigger = document.querySelector('[data-bs-target="#couponModal"]');

      // Wallet modal cleanup
      const walletModalEl = document.getElementById('walletPaymentModal');
      if (walletModalEl) {
        walletModalEl.addEventListener('hidden.bs.modal', function () {
          cleanupModalBackdrop();
          this.style.display = 'none';
          this.classList.remove('show');
        });

        const walletCloseButtons = walletModalEl.querySelectorAll('[data-bs-dismiss="modal"], .btn-close');
        walletCloseButtons.forEach(button => {
          button.addEventListener('click', function () {
            setTimeout(cleanupModalBackdrop, 100);
          });
        });
      }

      const cleanupBackdrop = () => {
        document.body.classList.remove('modal-open');
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
        document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
      };

      if (couponModalEl && trigger) {
        trigger.addEventListener('click', function (e) {
          e.preventDefault();
          try {
            let modal = bootstrap.Modal.getInstance(couponModalEl);
            if (!modal) {
              modal = new bootstrap.Modal(couponModalEl, { backdrop: true, keyboard: true });
            }
            modal.show();

            // Ensure modal is visible after showing
            setTimeout(() => {
              couponModalEl.classList.add('show');
              couponModalEl.style.display = 'block';
              couponModalEl.style.opacity = '1';
              couponModalEl.style.visibility = 'visible';
            }, 10);
          } catch (err) {
            console.error('Error showing coupon modal:', err);
          }
        });

        couponModalEl.addEventListener('hidden.bs.modal', cleanupBackdrop);
        couponModalEl.addEventListener('hide.bs.modal', () => {
          // remove any lingering non-show backdrops
          document.querySelectorAll('.modal-backdrop:not(.show)').forEach(el => el.remove());
        });
      }

      // Safety: if a backdrop exists but no modal is open, clean it up
      document.addEventListener('click', () => {
        const openModals = document.querySelectorAll('.modal.show');
        const backdrops = document.querySelectorAll('.modal-backdrop');
        if (backdrops.length && openModals.length === 0) cleanupBackdrop();
      });
    });
  </script>


  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <script>
    document.getElementById('couponForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = document.getElementById('couponCodeInput').value;
      try {
        const res = await fetch('/apply-coupon', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code })
        });
        const result = await res.json();

        if (result.ok) {
          document.getElementById('couponSuccess').innerText = result.msg;
          document.getElementById('couponError').innerText = '';
          document.getElementById('appliedCouponSection').style.display = 'block';
          document.getElementById('appliedCouponName').innerText = result.couponName;
          document.getElementById('couponFormSection').style.display = 'none';
          document.getElementById('grandTotal').innerText = `₹${result.newTotal}`;
          document.getElementById('discountAmount').innerText = result.discountAmount;
        } else {
          document.getElementById('couponError').innerText = result.msg;
          document.getElementById('couponSuccess').innerText = '';
        }
      } catch (err) {
        console.error(err);
      }
    });

    document.getElementById('removeCouponBtn').addEventListener('click', async () => {
      try {
        const res = await fetch('/remove-coupon', { method: 'DELETE' });
        const result = await res.json();
        if (result.ok) {
          document.getElementById('couponSuccess').innerText = result.msg;
          document.getElementById('couponError').innerText = '';
          document.getElementById('appliedCouponSection').style.display = 'none';
          document.getElementById('couponFormSection').style.display = 'block';
          document.getElementById('couponCodeInput').value = '';
          document.getElementById('grandTotal').innerText = `₹${result.newTotal}`;
          document.getElementById('discountAmount').innerText = '0';
        }
      } catch (err) {
        console.error(err);
      }
    });

    document.getElementById('applyCouponFromModal').addEventListener('click', () => {
      const selected = document.querySelector('input[name="selectedCoupon"]:checked');
      if (!selected) return Swal.fire("No Coupon", "Please select a coupon", "info");

      const code = selected.value;
      const input = document.getElementById('couponCodeInput');
      input.value = code;
      document.getElementById('couponSuccess').innerText = 'Coupon ready — click Apply to activate.';
      document.getElementById('couponError').innerText = '';
      bootstrap.Modal.getInstance(document.getElementById('couponModal')).hide();
      input.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => input.focus(), 300);
    });

    async function placeOrder() {
      const address = document.querySelector('input[name="selectedAddress"]:checked')?.value;
      const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value;

      if (!address || !paymentMethod) {
        return Swal.fire("Missing Info", "Please select address & payment method", "warning");
      }

      // Show wallet modal if wallet selected
      if (paymentMethod === 'Wallet') {
        const walletModalEl = document.getElementById('walletPaymentModal');
        if (!walletModalEl) {
          console.error('Wallet modal element not found');
          return Swal.fire("Error", "Wallet modal not found", "error");
        }

        const total = document.getElementById('grandTotal').innerText.replace('₹', '').replace(/,/g, '');
        const walletBalanceEl = document.getElementById('walletBalance');

        if (!walletBalanceEl) {
          console.error('Wallet balance element not found');
          return Swal.fire("Error", "Wallet balance not found", "error");
        }

        const walletBalance = parseFloat(walletBalanceEl.innerText.replace(/,/g, '')) || 0;
        const totalAmount = parseFloat(total) || 0;

        // Set payable amount
        const payableAmountEl = document.getElementById('payableAmount');
        if (payableAmountEl) {
          payableAmountEl.innerText = totalAmount.toFixed(2);
        }

        // Check if sufficient funds
        const insufficientFundsEl = document.getElementById('insufficientFunds');
        const confirmBtn = document.getElementById('confirmWalletPayment');

        if (walletBalance < totalAmount) {
          if (insufficientFundsEl) insufficientFundsEl.style.display = 'block';
          if (confirmBtn) confirmBtn.style.display = 'none';
        } else {
          if (insufficientFundsEl) insufficientFundsEl.style.display = 'none';
          if (confirmBtn) confirmBtn.style.display = 'inline-block';
        }

        // Show the modal using Bootstrap 5
        try {
          let walletModal = bootstrap.Modal.getInstance(walletModalEl);
          if (!walletModal) {
            walletModal = new bootstrap.Modal(walletModalEl, {
              backdrop: true,
              keyboard: true
            });
          }
          walletModal.show();

          // Ensure modal is visible
          setTimeout(() => {
            walletModalEl.classList.add('show');
            walletModalEl.style.display = 'block';
            walletModalEl.style.opacity = '1';
            walletModalEl.style.visibility = 'visible';
          }, 10);
        } catch (err) {
          console.error('Error showing wallet modal:', err);
          Swal.fire("Error", "Failed to open wallet payment modal", "error");
        }

        return; // Don't continue now, wait for wallet confirmation
      }

      // Continue as before for COD or Razorpay
      const res = await fetch('/place-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ selectedAddress: address, paymentMethod })
      });

      const data = await res.json();

      if (paymentMethod === 'Cash On Delivery') {
        if (data.status) window.location.href = `/order-success?orderId=${data.orderId}`;
        else Swal.fire("Failed", data.message, "error");
        return;
      }


      const options = {
        key: data.key,
        amount: data.amount,
        currency: 'INR',
        name: 'Glam Deck',
        description: 'Secure payment',

        order_id: data.razorpayOrderId,
        prefill: {
          name: '<%= user.name %>',
          email: '<%= user.email %>',
          contact: '<%= user.mobile %>'
        },
        theme: { color: '#0d6efd' },
        handler: async function (response) {
          try {
            const verify = await fetch('/verify-payment', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ...response, orderId: data.orderId })
            }).then(r => r.json());

            const url = verify.status ? '/order-success' : '/payment-failure';
            window.location = `${url}?orderId=${data.orderId}`;
          } catch (err) {
            // Network/server error, go to failure with retry option
            window.location = `/payment-failure?orderId=${data.orderId}`;
          }
        },
        modal: {
          ondismiss: function () {
            window.location = `/payment-failure?orderId=${data.orderId}`;

          }
        }
      };
      const rz = new Razorpay(options);
      // Explicitly handle failed payment callback
      rz.on('payment.failed', function () {
        window.location = `/payment-failure?orderId=${data.orderId}`;
      });
      rz.open();
    }


    document.getElementById('confirmWalletPayment').addEventListener('click', async () => {
      const address = document.querySelector('input[name="selectedAddress"]:checked')?.value;

      const res = await fetch('/place-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ selectedAddress: address, paymentMethod: 'Wallet' })
      });

      const data = await res.json();

      if (data.status) {
        window.location.href = `/order-success?orderId=${data.orderId}`;
      } else {
        Swal.fire("Failed", data.message, "error");
      }
    });

  </script>

  <%- include("../partials/user/footer") %>