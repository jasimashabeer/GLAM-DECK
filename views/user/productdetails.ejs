<%- include("../../views/partials/user/header") %>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= product.name %> - Product Details</title>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.5.5/dist/sweetalert2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/prodetail.css">
</head>
<body>
    <!-- Breadcrumb -->
    <div class="breadcrumb-container">
        <div class="breadcrumb">
            <a href="/welcome"><i class="fas fa-home"></i> Home</a>
            <span class="breadcrumb-separator">/</span>
            <a href="/products">Shop</a>
            <span class="breadcrumb-separator">/</span>
            <span><%= product.name %></span>
        </div>
    </div>
    
    <!-- Product Detail -->
    <div class="product-detail-container">
        <div class="product-detail-row">
            <!-- Image Section -->
            <div class="image-section">
                <div class="image-slider">
                    <% product.image.forEach((image, index) => { %>
                        <img src="<%= image %>" class="product-image <%= index === 0 ? 'active' : '' %>" alt="<%= product.name %> image <%= index+1 %>" />
                    <% }) %>
                </div>
            </div>
    
            <!-- Product Info -->
            <div class="product-info">
                <div class="product-header">
                    <h1><%= product.name %></h1>
                </div>

                <!-- Price Section -->
                <div class="price-section">
                    <div class="price-group">
                        <% if (product.discountPrice < product.price) { %>
                            <span class="old-price">₹<%= product.price %></span>
                            <span class="discount-price">₹<%= product.discountPrice %></span>
                        <% } else { %>
                            <span class="price">₹<%= product.price %></span>
                        <% } %>
                    </div>
                </div>

                <!-- Details Grid -->
                <div class="details-grid">
                    <div class="detail-item">
                        <label>Material</label>
                        <value><%= product.material %></value>
                    </div>
                    <div class="detail-item">
                        <label>Color</label>
                        <value><%= product.color %></value>
                    </div>
                    <div class="detail-item">
                        <label>Availability</label>
                        <value>
                            <% if (product.quantity > 0) { %>
                                <span class="stock-status in-stock">In Stock</span>
                            <% } else { %>
                                <span class="stock-status out-of-stock">Out of Stock</span>
                            <% } %>
                        </value>
                    </div>
                    <div class="detail-item">
                        <label>Quantity Available</label>
                        <value><%= product.quantity %> units</value>
                    </div>
                </div>

                <!-- Description -->
                <div class="description-section">
                    <label>Description</label>
                    <p><%= product.description %></p>
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons">
                    <button class="btn-primary add-to-cart" data-product-id="<%= product._id %>">
                        <i class="fas fa-shopping-cart"></i> Add to Cart
                    </button>
                    <button 
                        class="btn-secondary add-to-wishlist <%= wishlistProductIds.includes(product._id.toString()) ? 'active' : '' %>" 
                        data-product-id="<%= product._id %>">
                        <i class="fas <%= wishlistProductIds.includes(product._id.toString()) ? 'fas-heart' : 'far' %>-heart"></i>
                        <span><%= wishlistProductIds.includes(product._id.toString()) ? 'Wishlisted' : 'Add to Wishlist' %></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <div class="related-products-section">
        <h2 class="section-title">You Might Also Like</h2>
        <div class="related-products-grid">
            <% relatedProducts.forEach(rp => { %>
                <div class="related-product-card">
                    <a href="/productdetail/<%= rp._id %>">
                        <img src="<%= rp.image[0] %>" alt="<%= rp.name %>" class="related-product-image" />
                        <div class="related-product-info">
                            <h4><%= rp.name %></h4>
                            <p>₹<%= rp.discountPrice || rp.price %></p>
                        </div>
                    </a>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Image Slider
            const images = document.querySelectorAll(".image-slider img");
            let currentIndex = 0;

            function showImage(index) {
                images.forEach(function(img, i) {
                    img.classList.remove("active");
                    if (i === index) {
                        img.classList.add("active");
                    }
                });
            }

            // Auto slide every 3 seconds
            setInterval(function() {
                currentIndex = (currentIndex + 1) % images.length;
                showImage(currentIndex);
            }, 3000);

            // Wishlist Toggle
            const wishlistButtons = document.querySelectorAll(".add-to-wishlist");
            wishlistButtons.forEach(function(button) {
                button.addEventListener("click", async function() {
                    const productId = button.getAttribute("data-product-id");

                    try {
                        const response = await fetch("/wishlist/toggle/" + productId, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            }
                        });

                        const data = await response.json();

                        if (data.added) {
                            button.classList.add("active");
                            button.innerHTML = '<i class="fas fa-heart"></i><span>Wishlisted</span>';
                            
                            Swal.fire({
                                icon: 'success',
                                title: 'Added to Wishlist!',
                                text: 'This product has been added to your wishlist.',
                                timer: 1500,
                                showConfirmButton: false
                            });
                        } else {
                            button.classList.remove("active");
                            button.innerHTML = '<i class="far fa-heart"></i><span>Add to Wishlist</span>';
                            
                            Swal.fire({
                                icon: 'info',
                                title: 'Removed from Wishlist',
                                text: 'This product has been removed from your wishlist.',
                                timer: 1500,
                                showConfirmButton: false
                            });
                        }
                    } catch (error) {
                        console.error("Error:", error);
                        Swal.fire("Error", "Something went wrong.", "error");
                    }
                });
            });

            // Add to Cart
            const cartButton = document.querySelector(".add-to-cart");
            if (cartButton) {
                cartButton.addEventListener("click", async function() {
                    const productId = cartButton.getAttribute("data-product-id");
                    
                    try {
                        const response = await fetch("/add-to-cart", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({ productId: productId })
                        });

                        const data = await response.json();

                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: data.message,
                                confirmButtonColor: '#204056'
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Oops!',
                                text: data.message,
                                confirmButtonColor: '#f44336'
                            });
                        }
                    } catch (error) {
                        console.error("Error:", error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong',
                            confirmButtonColor: '#f44336'
                        });
                    }
                });
            }
        });
    </script>
</body>
</html>
















