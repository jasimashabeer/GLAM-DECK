

      <!DOCTYPE html>
      <html lang="en">
      <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>Admin Dashboard</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="/css/admin.css"/>
      </head>
      <style>
          #sidebar .nav-item.active .nav-link {
    background-color: #0d6efd !important;
    color: white !important;
    border-radius: 6px;
  }

  /* Active item for mobile menu */
  #offcanvasSidebar .nav-item.active .nav-link {
    background-color: #0d6efd !important;
    color: white !important;
    border-radius: 6px;
  }
      </style>
      <body>
        <header class="bg-light py-3 px-4 border-bottom d-flex justify-content-between align-items-center" style="background-color: #d1d8dd !important;">
            <!-- Toggle button only on small screens -->
            <button class="btn btn-outline-dark d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasSidebar">
              ☰ Menu
            </button>
            <h5 class="mb-0">Admin Dashboard</h5>
            <a href="/admin/logout" class="btn btn-outline-danger btn-sm">Logout</a>
          </header>
          
          
      
        <div class="d-flex">
          <!-- Sidebar (Visible on md+ screens) -->
          <nav id="sidebar" class="bg-dark text-white p-3 d-none d-md-block">
            <h4 class="text-center mb-4">BookMart</h4>
            <ul class="nav flex-column">
              <li class="nav-item"><a class="nav-link text-white" href="/admin/dashboard">Dashboard</a></li>
              <li class="nav-item"><a class="nav-link text-white" href="/admin/sales">Sales</a></li>
              <li class="nav-item"><a class="nav-link text-white" href="/admin/users">Customers</a></li>
              <li class="nav-item"><a class="nav-link text-white" href="/admin/category">Category</a></li>
        
              <li class="nav-item"><a class="nav-link text-white" href="/admin/products">Products</a></li>
              <li class="nav-item"><a class="nav-link text-white" href="/admin/coupons">Coupons</a></li>
              
               <li class="nav-item"><a class="nav-link text-white" href="/admin/orders">Orders</a></li>
            </ul>
          </nav>
      
          <!-- Offcanvas Sidebar for mobile -->
          <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="offcanvasSidebar">
            <div class="offcanvas-header">
              <h5 class="offcanvas-title">Menu</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body">
              <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link text-white" href="/admin/dashboard">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link text-white" href="/admin/sales">Sales</a></li>
                <li class="nav-item"><a class="nav-link text-white" href="/admin/users">Customers</a></li>

                <li class="nav-item"><a class="nav-link text-white" href="/admin/category">Category</a></li>
                <li class="nav-item"><a class="nav-link text-white" href="/admin/addProduct">Add Product</a></li>
                <li class="nav-item"><a class="nav-link text-white" href="/admin/products">Products</a></li>
                <li class="nav-item"><a class="nav-link text-white" href="/admin/coupons">Coupons</a></li>
               
                <li class="nav-item"><a class="nav-link text-white" href="/admin/orders">Orders</a></li>
              </ul>
            </div>
          </div>
      
          <script>
            (function () {
              try {
                var path = window.location.pathname || '/';
                var normalizedPath = (path || '/').replace(/\/$/, '') || '/';

                function applyActive(containerSelector) {
                  var container = document.querySelector(containerSelector);
                  if (!container) return;

                  var items = container.querySelectorAll('ul.nav li');
                  items.forEach(function (li) {
                    li.classList.remove('active');
                  });

                  var links = container.querySelectorAll('a.nav-link');
                  var matched = null;

                  links.forEach(function (a) {
                    try {
                      var url = new URL(a.getAttribute('href'), window.location.origin);
                      var aPath = (url.pathname || '/').replace(/\/$/, '') || '/';
                      if (aPath === normalizedPath) matched = a;
                    } catch (e) { }
                  });

                  if (!matched) {
                    links.forEach(function (a) {
                      try {
                        var url = new URL(a.getAttribute('href'), window.location.origin);
                        var aPath = (url.pathname || '/').replace(/\/$/, '') || '/';
                        if (aPath !== '/' && normalizedPath.indexOf(aPath) === 0) matched = a;
                      } catch (e) { }
                    });
                  }

                  if (matched) {
                    var li = matched.closest('li');
                    if (li) li.classList.add('active');
                  }
                }

                applyActive('nav#sidebar');
                applyActive('#offcanvasSidebar');
              } catch (e) {
                console.error(e);
              }
            })();
          </script>

          <!-- Main content area -->
          <div class="flex-grow-1">