<body>
<% var currentPage = typeof currentPage !== 'undefined' ? currentPage : ''; %>

<div class="top_bg">
	<div class="container">
		<div class="header_top-sec">
			<div class="top_right">
				<ul>
					<li><a href="contact.html"></a></li>
					<li><a href="login.html"></a></li>
				</ul>
			</div>
			
			<div class="clearfix"> </div>
		</div>
	</div>
</div>

<div class="header_top">
    <div class="container">
        <div class="logo">
            <a href="/">Glam Deck</a>			 
        </div>
        <div class="header_right">
            <% if (user && !user.isBlocked) { %>  
                <!-- Show when user is logged in -->
                <div class="user-info">
                    <span>Welcome, <%= user.name %>!</span>
                    <a href="/myaccount" class="user-link"><i class="icon icon-user" ></i></a>
                    
                    <a href="/wishlist" class="user-link"><i class="bi bi-heart-fill"></i></a>
                   
                    <a href="/cart" class="user-link"><i class="bi bi-cart-fill"></i></a>
<a href="/myaccount" class="user-link"><i class="bi bi-person-fill"></i></a>


					
                    <a href="/logout" class="logout-btn">Logout</a>
                </div>
            <% } else { %>
                <!-- Show when user is not logged in -->
                <div class="auth-links">
                    <a href="/signup">Signup</a> | <a href="/login">Login</a>
                </div>
            <% } %>
        </div>
        <div class="clearfix"></div>	
    </div>
</div>

		
	
<div class="mega_nav">
	 <div class="container">
		 <div class="menu_sec">
		 
