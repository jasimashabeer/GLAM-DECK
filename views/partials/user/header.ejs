			<li><a class="color1" href="/contact">Contact Us</a>
				
			</li>				
			<li><a  class="color1" href="/about">About Us</a>
				
			</li>								
		</ul>  -->




<ul class="megamenu skyblue">
  <li class="<%= currentPage === 'home' ? 'active grid' : 'grid' %>">
    <a class="color1" href="/">Home</a>
  </li>
  
  <li class="<%= currentPage === 'products' ? 'active grid' : 'grid' %>">
    <a class="color1" href="/products">Catalog</a>
  </li>
  
  <li class="<%= currentPage === 'contact' ? 'active grid' : 'grid' %>">
    <a class="color1" href="/contact">Contact Us</a>
  </li>
  
  <li class="<%= currentPage === 'about' ? 'active grid' : 'grid' %>">
    <a class="color1" href="/about">About Us</a>
  </li>
</ul>





	<div class="search">
	<form id="search-form" action="/products" method="GET">
		<input type="text" name="search" placeholder="Search..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
		<input type="submit" value="">
	</form>
</div>
		
